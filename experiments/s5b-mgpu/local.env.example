# Copy to experiments/s5b-mgpu/local.env (untracked) and edit for this machine. env.sh reads it.
# Leave a line commented to keep the default shown.

# Required (S0 asks the user once): the machine's own Sirius config for 4 GPUs, and the existing
# TPC-H SF1000 Parquet directory.
# S5B_SIRIUS_CONFIG=/path/to/sirius.yaml
# S5B_TPCH_SF1000=/raid/tpch/tpch_parquet_sf1000

# Parent of the build worktrees, the data and the raw run output (build trees take 30-60 GB each).
# S5B_HOME="$HOME/s5b-mgpu"

# TPC-H Parquet root holding tpch_parquet_sf{1,10,100}/, or one path per scale factor.
# S5B_DATA="$S5B_HOME/data"
# S5B_TPCH_SF100=/raid/tpch/tpch_parquet_sf100

# Raw run output (logs, CSV results, CPU reference answers, step output). Never committed.
# S5B_WORK="$S5B_HOME/work"

# DuckDB memory_limit for the CPU reference answers.
# S5B_CPU_MEMORY_LIMIT=60%

# Remote names in the control checkout.
# S5B_UPSTREAM_REMOTE=origin
# S5B_FORK_REMOTE=kevkrist
