+// PROTOTYPE (dfperf, transfer PR): CUCASCADE_PROTO_BATCH_STAGING=1 drops the per-buffer stream sync of
+// the host-staged GPU-to-GPU copy. The staging blocks of every buffer stay alive in this
+// thread-local list until convert_gpu_to_gpu has made its one table-level sync, so the whole table's
+// copies are queued on the links at once instead of one buffer per sync.
+int proto_batch_staging() noexcept
+{
+  // 0 = off; 1 = no per-buffer sync (copies still interleave D2H, H2D per buffer on the stream);
+  // 2 = two phases: every buffer's device-to-host copy first, then every host-to-device copy in
+  //     one contiguous train (one wait on the target GPU's ingress queue for the whole table).
+  static int const value = [] {
+    auto const* text = std::getenv("CUCASCADE_PROTO_BATCH_STAGING");
+    return text != nullptr ? std::atoi(text) : 0;
+  }();
+  return value;
+}
+
+std::vector<std::shared_ptr<void>>& proto_deferred_staging() noexcept
+{
+  thread_local std::vector<std::shared_ptr<void>> blocks;
+  return blocks;
+}
+
+//! Mode 2: host-to-device halves not issued yet; each closure owns its staging blocks.
+std::vector<std::function<void(::cuda::stream_ref)>>& proto_deferred_h2d() noexcept
+{
+  thread_local std::vector<std::function<void(::cuda::stream_ref)>> pending;
+  return pending;
+}
+
+//! Issues every pending host-to-device half on @p stream; the blocks stay alive until the guard.
+void proto_flush_deferred_h2d(::cuda::stream_ref stream)
+{
+  auto& pending = proto_deferred_h2d();
+  for (auto& issue : pending) {
+    issue(stream);
+    proto_deferred_staging().push_back(
+      std::make_shared<std::function<void(::cuda::stream_ref)>>(std::move(issue)));
+  }
+  pending.clear();
+}
+
+struct proto_deferred_staging_guard {
+  ~proto_deferred_staging_guard()
+  {
+    proto_deferred_h2d().clear();
+    proto_deferred_staging().clear();
+  }
+};
+
