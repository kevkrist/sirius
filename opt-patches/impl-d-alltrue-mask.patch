+// ---------------------------------------------------------------------------
+// survivor_indices: positions of select()'s survivors, no data gather
+// ---------------------------------------------------------------------------
+
+TEMPLATE_TEST_CASE("survivor_indices reports surviving row positions",
+                   "[expression_evaluator]",
+                   mat_strategy,
+                   ast_interpret_strategy,
+                   ast_jit_strategy)
+{
+  constexpr auto strategy = TestType::value;
+  auto* space             = get_default_gpu_space();
+  REQUIRE(space != nullptr);
+
+  auto run_survivors = [&](std::shared_ptr<data_batch> const& input_batch,
+                           std::unique_ptr<ast_node> node) {
+    exp_executor executor(*node, get_resource_ref(*space), cudf::get_default_stream(), strategy);
+    auto input_ro  = input_batch->to_read_only();
+    auto& in_repr  = input_ro.get_data()->cast<gpu_table_representation>();
+    auto positions = executor.survivor_indices(in_repr.get_table_view());
+    REQUIRE(positions != nullptr);
+    REQUIRE(positions->type().id() == cudf::type_id::INT32);
+    return positions;
+  };
+
+  std::vector<int32_t> values(64);
+  std::iota(values.begin(), values.end(), 0);
+  std::vector<bool> all_valid(values.size(), true);
+
+  SECTION("all rows survive: identity positions")
+  {
+    auto input = make_int32_batch_with_nulls(*space, values, all_valid);
+    auto positions =
+      run_survivors(input, make_cmp(sirius::comparison_type::gt, make_ref(0), make_int_const(-1)));
+    std::vector<int32_t> expected(values.size());
+    std::iota(expected.begin(), expected.end(), 0);
+    REQUIRE(copy_column_to_host<int32_t>(positions->view()) == expected);
+  }
+
+  SECTION("no row survives: empty positions")
+  {
+    auto input     = make_int32_batch_with_nulls(*space, values, all_valid);
+    auto positions = run_survivors(
+      input, make_cmp(sirius::comparison_type::gt, make_ref(0), make_int_const(1000)));
+    REQUIRE(positions->size() == 0);
+  }
+
+  SECTION("mixed mask: ascending positions of the passing rows")
+  {
+    auto input = make_int32_batch_with_nulls(*space, values, all_valid);
+    auto positions =
+      run_survivors(input, make_cmp(sirius::comparison_type::ge, make_ref(0), make_int_const(32)));
+    std::vector<int32_t> expected(32);
+    std::iota(expected.begin(), expected.end(), 32);
+    REQUIRE(copy_column_to_host<int32_t>(positions->view()) == expected);
+  }
+
+  SECTION("null predicate results drop the row, matching select()")
+  {
+    // Every valid value passes the predicate; null rows must still be dropped,
+    // proving the count is (value && valid) rather than the raw true count.
+    std::vector<int32_t> vals = {10, 20, 30, 40, 50};
+    std::vector<bool> valids  = {true, false, true, false, true};
+    auto input                = make_int32_batch_with_nulls(*space, vals, valids);
+    auto positions =
+      run_survivors(input, make_cmp(sirius::comparison_type::gt, make_ref(0), make_int_const(0)));
+    REQUIRE(copy_column_to_host<int32_t>(positions->view()) == std::vector<int32_t>{0, 2, 4});
+  }
+
+  SECTION("all predicate results null: empty positions")
+  {
+    std::vector<int32_t> vals = {10, 20, 30};
+    std::vector<bool> valids  = {false, false, false};
+    auto input                = make_int32_batch_with_nulls(*space, vals, valids);
+    auto positions =
+      run_survivors(input, make_cmp(sirius::comparison_type::gt, make_ref(0), make_int_const(0)));
+    REQUIRE(positions->size() == 0);
+  }
+}
