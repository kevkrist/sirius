+void exec_ok(duckdb::Connection& con, const std::string& q)
+{
+  auto result = con.Query(q);
+  REQUIRE(result);
+  if (result->HasError()) {
+    INFO("query failed: " << q << "\n  error: " << result->GetError());
+    REQUIRE_FALSE(result->HasError());
+  }
+}
