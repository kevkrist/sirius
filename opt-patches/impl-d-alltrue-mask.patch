+  auto* mask_ptr  = static_cast<cudf::bitmask_type*>(null_mask.data());
+  cudf::size_type null_count = 0;
+  for (cudf::size_type i = 0; i < size; ++i) {
+    if (!valids[static_cast<std::size_t>(i)]) {
+      cudf::set_null_mask(mask_ptr, i, i + 1, false, stream);
+      ++null_count;
+    }
+  }
+  auto col = cudf::make_numeric_column(
+    cudf::data_type{cudf::type_id::INT32}, size, std::move(null_mask), null_count, stream, mr);
+  cudaMemcpy(col->mutable_view().data<std::int32_t>(),
+             values.data(),
+             sizeof(std::int32_t) * values.size(),
+             cudaMemcpyHostToDevice);
+  return col;
+}
+
+std::unique_ptr<cudf::table> make_id_val_table(std::vector<std::int32_t> const& id,
+                                               std::vector<std::int32_t> const& val,
+                                               rmm::cuda_stream_view stream,
+                                               rmm::device_async_resource_ref mr)
+{
+  std::vector<std::unique_ptr<cudf::column>> cols;
+  cols.push_back(make_int32_column(id, stream, mr));
+  cols.push_back(make_int32_column(val, stream, mr));
+  return std::make_unique<cudf::table>(std::move(cols));
+}
+
+std::vector<std::int32_t> download_int32(cudf::column_view const& col, rmm::cuda_stream_view stream)
+{
+  std::vector<std::int32_t> out(static_cast<std::size_t>(col.size()));
+  cudaMemcpyAsync(out.data(),
+                  col.data<std::int32_t>(),
+                  out.size() * sizeof(std::int32_t),
+                  cudaMemcpyDeviceToHost,
+                  stream.value());
+  cudaStreamSynchronize(stream.value());
+  return out;
+}
+
+std::vector<std::int32_t> iota_values(std::size_t n)
+{
+  std::vector<std::int32_t> v(n);
+  std::iota(v.begin(), v.end(), 0);
+  return v;
+}
+
+/// A keep-alive owner that does NOT satisfy no_alloc_materializable, standing in
+/// for the cache-served read-lock owner (D-2's view-backed shape).
+struct table_keepalive {
+  std::unique_ptr<cudf::table> table;
+};
+
+/// One environment per TEST_CASE: DB + storage + memory manager + stream.
+struct post_filter_fixture {
+  post_filter_test_db env;
+  std::unique_ptr<sirius::memory::sirius_memory_reservation_manager> mem_mgr;
+  cucascade::memory::memory_space* gpu_space = nullptr;
+  rmm::cuda_stream stream;
+  duckdb::DataTable* storage = nullptr;
+
+  post_filter_fixture()
+  {
+    exec_ok(*env.con, "SET force_compression='uncompressed'");
+    exec_ok(*env.con, "CREATE TABLE t(id INTEGER, val INTEGER)");
+    exec_ok(*env.con, "INSERT INTO t SELECT i::INTEGER, i::INTEGER FROM range(1000) tbl(i)");
+    exec_ok(*env.con, "CHECKPOINT");
+    exec_ok(*env.con, "BEGIN TRANSACTION");
+    storage = &resolve_storage(*env.con, "t");
+
+    mem_mgr   = initialize_memory_manager();
+    gpu_space = sirius::scan_test_utils::get_space(*mem_mgr, cucascade::memory::Tier::GPU);
+    REQUIRE(gpu_space != nullptr);
+  }
+
+  [[nodiscard]] rmm::device_async_resource_ref mr() const
+  {
+    return gpu_space->get_default_allocator();
+  }
+
+  std::unique_ptr<cudf::table> run(std::shared_ptr<duckdb_native_gpu_ingestible> const& ingestible,
+                                   filtered_table&& input)
+  {
+    return ingestible->post_filter_and_project(std::move(input),
+                                               *gpu_space,
+                                               stream.view(),
+                                               /*like_swar_fastpath=*/false,
+                                               /*like_cache=*/nullptr,
+                                               /*survivors=*/nullptr,
+                                               /*elided=*/{});
+  }
+};
+
+}  // namespace
