+  // Type-erase behind a generic owner: is_no_alloc_materializable() is false, so the
+  // move shortcut must NOT engage and the folded select() gather runs as before.
+  auto out =
+    fx.run(ingestible,
+           filtered_table{.table = owning_table_view{table_keepalive{std::move(table)}, base_view},
+                          .state = filter_state::UNFILTERED});
