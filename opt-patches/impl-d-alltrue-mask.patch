+/// Requires an active transaction on @p con (catalog access needs one).
+duckdb::DataTable& resolve_storage(duckdb::Connection& con, const std::string& table_name)
+{
+  auto& ctx     = *con.context;
+  auto& catalog = duckdb::Catalog::GetCatalog(ctx, "");
+  duckdb::CatalogTransaction txn(catalog, ctx);
+  auto& schema = catalog.GetSchema(txn, "main");
+  auto entry   = schema.GetEntry(txn, duckdb::CatalogType::TABLE_ENTRY, table_name);
+  REQUIRE(entry);
+  return entry->Cast<duckdb::DuckTableEntry>().GetStorage();
+}
+
+projected_column real_col(duckdb::idx_t col_id)
+{
+  projected_column pc;
+  pc.storage_idx = duckdb::StorageIndex(col_id);
+  pc.is_rowid    = false;
+  return pc;
+}
+
+/// An ingestible over t(id INTEGER, val INTEGER) whose baked-in filter is
+/// `val >= threshold` (val is the trailing column, so with output_arity == 1 it
+/// is a pure-filter column the projection must drop).
+std::shared_ptr<duckdb_native_gpu_ingestible> make_filtering_ingestible(duckdb::DataTable& storage,
+                                                                        duckdb::ClientContext& ctx,
+                                                                        std::int32_t threshold,
+                                                                        std::size_t output_arity)
+{
+  auto const int_type = sirius::logical_type::make(sirius::type_id::INTEGER);
+
+  auto info             = std::make_unique<duckdb_native_ingestible_table_info>();
+  info->storage         = &storage;
+  info->context         = &ctx;
+  info->projected_cols  = {real_col(0), real_col(1)};
+  info->projected_types = {int_type, int_type};
+  info->returned_types.push_back(int_type);
+  info->returned_types.push_back(int_type);
+  info->column_ids.push_back(duckdb::ColumnIndex(0));
+  info->column_ids.push_back(duckdb::ColumnIndex(1));
+  for (std::size_t i = 0; i < output_arity; ++i) {
+    info->output_types.push_back(int_type);
+  }
+
+  auto filters = duckdb::make_uniq<duckdb::TableFilterSet>();
+  filters->PushFilter(
+    duckdb::ColumnIndex(1),
+    duckdb::make_uniq<duckdb::ConstantFilter>(duckdb::ExpressionType::COMPARE_GREATERTHANOREQUALTO,
+                                              duckdb::Value::INTEGER(threshold)));
+  info->table_filters = std::move(filters);
+  return make_ingestible(std::move(info));
+}
