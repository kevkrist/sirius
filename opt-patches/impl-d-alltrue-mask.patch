+TEST_CASE("owning_table_view is_no_alloc_materializable reflects the release path",
+          "[owning_table_view]")
+{
+  // Empty handle: release() returns nullptr without device work.
+  owning_table_view empty;
+  REQUIRE(empty.is_no_alloc_materializable());
+
+  // Owned table: release() is a pure move.
+  owning_table_view owned{tagged_table({10, 20})};
+  REQUIRE(owned.is_no_alloc_materializable());
+
+  // Demoting an owned table to a view (column selection) keeps the moving path.
+  std::array<std::size_t, 1> drop{0};
+  owned.drop_columns(drop);
+  REQUIRE(owned.is_no_alloc_materializable());
+
+  // A generic owner forces the copying (and synchronizing) materialization.
+  auto table     = tagged_table({30, 40});
+  auto base_view = table->view();
+  owning_table_view generic{table_keepalive{std::move(table)}, base_view};
+  REQUIRE_FALSE(generic.is_no_alloc_materializable());
+}
+
 // Stream-ordering regression: the copying materialization path must not let the
 // caller reclaim the source memory while the copy is still in flight.
