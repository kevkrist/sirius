+TEST_CASE("post_filter null mask entries drop the row (count is value AND valid)",
+          "[scan][duckdb_native_post_filter]")
+{
+  post_filter_fixture fx;
+  auto ingestible =
+    make_filtering_ingestible(*fx.storage, *fx.env.con->context, /*threshold=*/0, /*arity=*/1);
+
+  auto const n = std::size_t{10};
+  // Every VALID val passes the predicate, but even rows are NULL: were the count the
+  // raw true count, this would wrongly take the all-true move path.
+  std::vector<bool> valids(n);
+  std::vector<std::int32_t> expected;
+  for (std::size_t i = 0; i < n; ++i) {
+    valids[i] = (i % 2) != 0;
+    if (valids[i]) { expected.push_back(static_cast<std::int32_t>(i)); }
+  }
+  std::vector<std::unique_ptr<cudf::column>> cols;
+  cols.push_back(make_int32_column(iota_values(n), fx.stream.view(), fx.mr()));
+  cols.push_back(make_int32_column_with_nulls(
+    std::vector<std::int32_t>(n, 100), valids, fx.stream.view(), fx.mr()));
+  auto table = std::make_unique<cudf::table>(std::move(cols));
+
+  auto out = fx.run(ingestible,
+                    filtered_table{.table = owning_table_view{std::move(table)},
+                                   .state = filter_state::UNFILTERED});
+  REQUIRE(out->num_columns() == 1);
+  REQUIRE(download_int32(out->view().column(0), fx.stream.view()) == expected);
+}
