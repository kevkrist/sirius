+TEST_CASE("post_filter all-true mask moves the decoded columns (no gather)",
+          "[scan][duckdb_native_post_filter]")
+{
+  post_filter_fixture fx;
+  auto ingestible =
+    make_filtering_ingestible(*fx.storage, *fx.env.con->context, /*threshold=*/0, /*arity=*/1);
+
+  auto const n = std::size_t{100};
+  auto table =
+    make_id_val_table(iota_values(n), std::vector<std::int32_t>(n, 50), fx.stream.view(), fx.mr());
+  auto const* id_ptr = table->view().column(0).head();
+
+  auto out = fx.run(ingestible,
+                    filtered_table{.table = owning_table_view{std::move(table)},
+                                   .state = filter_state::UNFILTERED});
+  REQUIRE(out != nullptr);
+  REQUIRE(out->num_columns() == 1);  // pure-filter column dropped
+  REQUIRE(static_cast<std::size_t>(out->num_rows()) == n);
+  REQUIRE(download_int32(out->view().column(0), fx.stream.view()) == iota_values(n));
+  // The decisive fast-path observation: the output column reuses the decoded buffer.
+  REQUIRE(out->view().column(0).head() == id_ptr);
+}
