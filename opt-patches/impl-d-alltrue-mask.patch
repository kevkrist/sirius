+std::unique_ptr<cudf::column> expression_evaluator::survivor_indices(cudf::table_view input)
+{
+  auto mask = compute_mask(input);
+  // Compacting a row-index sequence through apply_boolean_mask keeps the null convention (and
+  // the single output-size readback) identical to select()'s gather while touching only 4 bytes
+  // per row instead of every output column.
+  auto positions = cudf::sequence(input.num_rows(),
+                                  cudf::numeric_scalar<std::int32_t>(0, true, _stream, _mr),
+                                  cudf::numeric_scalar<std::int32_t>(1, true, _stream, _mr),
+                                  _stream,
+                                  _mr);
+  auto surviving =
+    cudf::apply_boolean_mask(cudf::table_view{{positions->view()}}, mask->view(), _stream, _mr);
+  return std::move(surviving->release().front());
+}
