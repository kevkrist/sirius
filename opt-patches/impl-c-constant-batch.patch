+TEST_CASE_METHOD(decode_env,
+                 "gpu_decode_table - CONSTANT batched across columns, widths, and copy chunks",
+                 "[scan][decode]")
+{
+  // Every CONSTANT run of the table fills through one batched launch. Three
+  // columns of different value widths share it, and the int64 run's 320,000
+  // bytes exceed COPY_CHUNK_BYTES so its work splits across several chunks.
+  constexpr uint32_t ROWS = 40000;
+  cudf::data_type const I16{cudf::type_id::INT16};
+  std::vector<int64_t> v64  = {0x1122334455667788LL};
+  std::vector<int32_t> v32a = {-7}, v32b = {13};
+  std::vector<int16_t> v16 = {-2};
+  auto d64                 = upload(v64, stream.view());
+  auto d32a                = upload(v32a, stream.view());
+  auto d32b                = upload(v32b, stream.view());
+  auto d16                 = upload(v16, stream.view());
+
+  std::vector<gpu_column_decode_input> cols = {
+    one_codec_column(I64, ROWS, CompressionType::COMPRESSION_CONSTANT, {segment(d64, 0, ROWS)}),
+    one_codec_column(I32,
+                     ROWS,
+                     CompressionType::COMPRESSION_CONSTANT,
+                     {segment(d32a, 0, 1000), segment(d32b, 1000, ROWS - 1000)}),
+    one_codec_column(I16, ROWS, CompressionType::COMPRESSION_CONSTANT, {segment(d16, 0, ROWS)})};
+
+  auto t   = decode(cols);
+  auto o64 = download<int64_t>(t->get_column(0).view().data<int64_t>(), ROWS, stream.value());
+  auto o32 = download<int32_t>(t->get_column(1).view().data<int32_t>(), ROWS, stream.value());
+  auto o16 = download<int16_t>(t->get_column(2).view().data<int16_t>(), ROWS, stream.value());
+  for (uint32_t i = 0; i < ROWS; ++i) {
+    if (o64[i] != 0x1122334455667788LL) FAIL("int64 mismatch at row " << i);
+    if (o32[i] != (i < 1000 ? -7 : 13)) FAIL("int32 mismatch at row " << i);
+    if (o16[i] != -2) FAIL("int16 mismatch at row " << i);
+  }
+}
