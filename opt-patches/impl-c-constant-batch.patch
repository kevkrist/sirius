+TEST_CASE_METHOD(decode_env,
+                 "gpu_decode_table - CONSTANT runs interleaved with UNCOMPRESSED in one column",
+                 "[scan][decode]")
+{
+  // The deferred CONSTANT fill launches after every other codec of the table
+  // decode; disjoint per-run row ranges make that reordering safe. Pin it with
+  // CONSTANT [0,600) + UNCOMPRESSED [600,1100) + CONSTANT [1100,1600).
+  std::vector<int32_t> c1 = {42}, c2 = {-9};
+  std::vector<int32_t> mid(500);
+  std::iota(mid.begin(), mid.end(), 1000);
+  auto dc1 = upload(c1, stream.view());
+  auto dc2 = upload(c2, stream.view());
+  auto dm  = upload(mid, stream.view());
+
+  auto col =
+    one_codec_column(I32, 1600, CompressionType::COMPRESSION_CONSTANT, {segment(dc1, 0, 600)});
+  col.data.push_back({CompressionType::COMPRESSION_UNCOMPRESSED, {segment(dm, 600, 500)}});
+  col.data.push_back({CompressionType::COMPRESSION_CONSTANT, {segment(dc2, 1100, 500)}});
+
+  auto t   = decode({col});
+  auto out = download<int32_t>(t->get_column(0).view().data<int32_t>(), 1600, stream.value());
+  for (uint32_t i = 0; i < 1600; ++i) {
+    int32_t const want = i < 600 ? 42 : (i < 1100 ? static_cast<int32_t>(1000 + (i - 600)) : -9);
+    if (out[i] != want) FAIL("mismatch at row " << i << " want " << want << " got " << out[i]);
+  }
+}
