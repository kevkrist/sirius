+TEST_CASE("multi-segment CONSTANT columns decode from packed stats values with zero file reads",
+          "[scan][duckdb_native_host_backed][duckdb_native_constant]")
+{
+  // CONSTANT data segments have no payload bytes; their value rides the
+  // segment stats snapshotted by the walker. The decoder packs every such
+  // value of a split into one blob and uploads it in a single copy. A column
+  // constant within each row group but different across them checkpoints as
+  // (at least) one CONSTANT segment per row group, giving the multi-segment
+  // shape, and the null datasource proves the split stages zero file reads.
+  constexpr std::size_t N_ROWS   = 130000;  // two row groups: 122,880 + 7,120
+  constexpr std::size_t RG_SPLIT = 122880;
+
+  host_backed_test_db env;
+  exec_ok(*env.con, "CREATE TABLE t(k INTEGER, c BIGINT)");
+  exec_ok(*env.con,
+          "INSERT INTO t SELECT i::INTEGER, (CASE WHEN i < 122880 THEN 7 ELSE -3 END)::BIGINT "
+          "FROM range(130000) tbl(i)");
+  exec_ok(*env.con, "CHECKPOINT");
+  exec_ok(*env.con, "BEGIN TRANSACTION");
+  auto& storage = resolve_storage(*env.con, "t");
+
+  auto mem_mgr    = initialize_memory_manager();
+  auto* gpu_space = sirius::scan_test_utils::get_space(*mem_mgr, cucascade::memory::Tier::GPU);
+  REQUIRE(gpu_space != nullptr);
+  rmm::cuda_stream stream;
+
+  auto require_c_matches = [&](cudf::table const& t, std::size_t c_col_idx) {
+    REQUIRE(static_cast<std::size_t>(t.num_rows()) == N_ROWS);
+    auto out =
+      download<int64_t>(t.get_column(c_col_idx).view().data<int64_t>(), N_ROWS, stream.view());
+    for (std::size_t i = 0; i < N_ROWS; ++i) {
+      auto const want = i < RG_SPLIT ? std::int64_t{7} : std::int64_t{-3};
+      if (out[i] != want) { FAIL("c mismatch at row " << i); }
+    }
+  };
+
+  SECTION("all-CONSTANT projection: the packed values blob is the only upload")
+  {
+    std::vector<projected_column> cols      = {real_col(1)};
+    std::vector<sirius::logical_type> types = {sirius::logical_type::make(sirius::type_id::BIGINT)};
+    auto md                                 = walk_all(storage, *env.con->context, cols, types);
+
+    // Pin the shape the test is about: several CONSTANT data segments, each
+    // carrying its stats-borne value.
+    std::size_t n_constant = 0;
+    for (auto const& rg : md) {
+      for (auto const& s : rg.columns[0].data_segments) {
+        if (s.compression != duckdb::CompressionType::COMPRESSION_CONSTANT) { continue; }
+        REQUIRE(s.segment_stats != nullptr);
+        ++n_constant;
+      }
+    }
+    REQUIRE(n_constant >= 2);
+
+    duckdb_native_ingestible_table_info info;
+    info.storage         = &storage;
+    info.context         = env.con->context.get();
+    info.projected_cols  = cols;
+    info.projected_types = types;
+
+    auto table =
+      decode_duckdb_native_split(md, info, /*datasource=*/nullptr, *gpu_space, stream.view());
+    REQUIRE(table->num_columns() == 1);
+    require_c_matches(*table, 0);
+  }
+
+  SECTION("packed constants coexist with host-backed segments in the reads-empty lane")
+  {
+    std::vector<projected_column> cols      = {real_col(0), real_col(1)};
+    std::vector<sirius::logical_type> types = {sirius::logical_type::make(sirius::type_id::INTEGER),
+                                               sirius::logical_type::make(sirius::type_id::BIGINT)};
+    auto md                                 = walk_all(storage, *env.con->context, cols, types);
+
+    // Host-back k's block-backed segments; c's CONSTANT segments have no
+    // blocks, so they keep their stats-borne values and take the blob lane.
+    std::vector<std::shared_ptr<void>> keepalive;
+    host_back_segments(*env.con->context, storage, md, keepalive, /*clear_block_ids=*/true);
+
+    duckdb_native_ingestible_table_info info;
+    info.storage         = &storage;
+    info.context         = env.con->context.get();
+    info.projected_cols  = cols;
+    info.projected_types = types;
+
+    auto table =
+      decode_duckdb_native_split(md, info, /*datasource=*/nullptr, *gpu_space, stream.view());
+    REQUIRE(table->num_columns() == 2);
+    auto k_out =
+      download<int32_t>(table->get_column(0).view().data<int32_t>(), N_ROWS, stream.view());
+    for (std::size_t i = 0; i < N_ROWS; ++i) {
+      if (k_out[i] != static_cast<int32_t>(i)) { FAIL("k mismatch at row " << i); }
+    }
+    require_c_matches(*table, 1);
+  }
+}
