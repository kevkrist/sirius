+#include <vector>
+
+using cucascade::detail::batch_copy_entry;
+using cucascade::detail::launch_batch_gather_copy;
+
+namespace {
+
+constexpr uint8_t guard_byte = 0xEE;
+
+/// One test copy: source/destination offsets are placed at the requested 16-byte phase.
+struct copy_case {
+  std::size_t src_phase;
+  std::size_t dst_phase;
+  std::size_t length;
+};
+
+constexpr std::size_t align_up(std::size_t value, std::size_t alignment)
+{
+  return (value + alignment - 1) / alignment * alignment;
+}
+
+/// RAII pinned host allocation mirroring the converter's source memory (Portable + Mapped).
+struct pinned_buffer {
+  uint8_t* data = nullptr;
+
+  explicit pinned_buffer(std::size_t bytes)
+  {
+    CUCASCADE_CUDA_TRY(cudaHostAlloc(
+      reinterpret_cast<void**>(&data), bytes, cudaHostAllocPortable | cudaHostAllocMapped));
+  }
+  ~pinned_buffer() { cudaFreeHost(data); }
+  pinned_buffer(const pinned_buffer&)            = delete;
+  pinned_buffer& operator=(const pinned_buffer&) = delete;
+};
+
+/// RAII device allocation.
+struct device_buffer_raw {
+  uint8_t* data = nullptr;
+
+  explicit device_buffer_raw(std::size_t bytes)
+  {
+    CUCASCADE_CUDA_TRY(cudaMalloc(reinterpret_cast<void**>(&data), bytes));
+  }
+  ~device_buffer_raw() { cudaFree(data); }
+  device_buffer_raw(const device_buffer_raw&)            = delete;
+  device_buffer_raw& operator=(const device_buffer_raw&) = delete;
+};
+
+}  // namespace
+
+// Compares the gather-copy kernel's output against a plain host-side memcpy of the same entries,
+// across every alignment shape the kernel distinguishes: matching 16-byte phases (with and
+// without the 8-byte head peel), mismatched 16-byte phases (the 8-byte word path), sub-8-byte
+// alignment (the defensive byte path), and lengths from 0 through a multi-megabyte entry with odd
+// tails. Destination guard bytes around each entry verify the kernel writes exactly the requested
+// ranges and nothing else.
+TEST_CASE("batch gather-copy kernel matches memcpy for scattered entries of odd sizes and phases",
+          "[sm_copy][gather_copy]")
+{
+  const std::vector<std::size_t> lengths = {
+    0, 1, 7, 8, 9, 15, 16, 17, 24, 31, 32, 33, 255, 1000, 4096, 4097, (1u << 20) + 13};
+  const std::vector<std::pair<std::size_t, std::size_t>> phases = {{0, 0}, {8, 8}, {8, 0}, {0, 8}};
+
+  std::vector<copy_case> cases;
+  for (const auto& [src_phase, dst_phase] : phases) {
+    for (const std::size_t length : lengths) {
+      cases.push_back({src_phase, dst_phase, length});
+    }
+  }
+  // Defensive byte path: starts below 8-byte alignment (never produced by the pin layout).
+  cases.push_back({4, 4, 37});
+  cases.push_back({1, 3, 13});
+  cases.push_back({2, 6, 64});
+
+  // Lay the entries out with 16-byte-aligned bases plus the requested phase, and a guard gap
+  // after each destination range.
+  constexpr std::size_t guard_gap = 32;
+  std::size_t src_cursor          = 0;
+  std::size_t dst_cursor          = guard_gap;
+  std::vector<std::size_t> src_offsets;
+  std::vector<std::size_t> dst_offsets;
+  for (const copy_case& c : cases) {
+    src_cursor = align_up(src_cursor, 16) + c.src_phase;
+    dst_cursor = align_up(dst_cursor, 16) + c.dst_phase;
+    src_offsets.push_back(src_cursor);
+    dst_offsets.push_back(dst_cursor);
+    src_cursor += c.length;
+    dst_cursor += c.length + guard_gap;
+  }
+  const std::size_t src_bytes = src_cursor;
+  const std::size_t dst_bytes = dst_cursor;
+
+  pinned_buffer src{src_bytes};
+  for (std::size_t i = 0; i < src_bytes; ++i) {
+    src.data[i] = static_cast<uint8_t>((i * 131 + 17) & 0xFF);
+  }
+
+  device_buffer_raw dst{dst_bytes};
+  CUCASCADE_CUDA_TRY(cudaMemset(dst.data, guard_byte, dst_bytes));
+
+  std::vector<batch_copy_entry> entries;
+  entries.reserve(cases.size());
+  for (std::size_t i = 0; i < cases.size(); ++i) {
+    entries.push_back({src.data + src_offsets[i], dst.data + dst_offsets[i], cases[i].length});
+  }
+  device_buffer_raw device_entries{entries.size() * sizeof(batch_copy_entry)};
+  CUCASCADE_CUDA_TRY(cudaMemcpy(device_entries.data,
+                                entries.data(),
+                                entries.size() * sizeof(batch_copy_entry),
+                                cudaMemcpyHostToDevice));
+
+  rmm::cuda_stream stream;
+  launch_batch_gather_copy(
+    reinterpret_cast<const batch_copy_entry*>(device_entries.data), entries.size(), stream.value());
+  stream.synchronize();
+
+  // Reference: guard-filled destination with each entry memcpy'd on the host.
+  std::vector<uint8_t> expected(dst_bytes, guard_byte);
+  for (std::size_t i = 0; i < cases.size(); ++i) {
+    std::memcpy(expected.data() + dst_offsets[i], src.data + src_offsets[i], cases[i].length);
+  }
+
+  std::vector<uint8_t> actual(dst_bytes);
+  CUCASCADE_CUDA_TRY(cudaMemcpy(actual.data(), dst.data, dst_bytes, cudaMemcpyDeviceToHost));
+
+  REQUIRE(std::memcmp(actual.data(), expected.data(), dst_bytes) == 0);
+}
+
+// The grid strides over entries block-by-block; an entry count far above the launch grid checks
+// the stride loop and that many tiny entries land intact.
+TEST_CASE("batch gather-copy kernel handles entry counts beyond the launch grid",
+          "[sm_copy][gather_copy]")
+{
+  constexpr std::size_t num_entries = 20'000;
+  constexpr std::size_t entry_bytes = 8;
+
+  pinned_buffer src{num_entries * entry_bytes};
+  for (std::size_t i = 0; i < num_entries * entry_bytes; ++i) {
+    src.data[i] = static_cast<uint8_t>((i * 37 + 5) & 0xFF);
+  }
+  device_buffer_raw dst{num_entries * entry_bytes};
+  CUCASCADE_CUDA_TRY(cudaMemset(dst.data, guard_byte, num_entries * entry_bytes));
+
+  // Reverse the entry order so consecutive descriptors reference non-adjacent memory.
+  std::vector<batch_copy_entry> entries;
+  entries.reserve(num_entries);
+  for (std::size_t i = 0; i < num_entries; ++i) {
+    const std::size_t j = num_entries - 1 - i;
+    entries.push_back({src.data + j * entry_bytes, dst.data + j * entry_bytes, entry_bytes});
+  }
+  device_buffer_raw device_entries{entries.size() * sizeof(batch_copy_entry)};
+  CUCASCADE_CUDA_TRY(cudaMemcpy(device_entries.data,
+                                entries.data(),
+                                entries.size() * sizeof(batch_copy_entry),
+                                cudaMemcpyHostToDevice));
+
+  rmm::cuda_stream stream;
+  launch_batch_gather_copy(
+    reinterpret_cast<const batch_copy_entry*>(device_entries.data), entries.size(), stream.value());
+  stream.synchronize();
+
+  std::vector<uint8_t> actual(num_entries * entry_bytes);
+  CUCASCADE_CUDA_TRY(
+    cudaMemcpy(actual.data(), dst.data, num_entries * entry_bytes, cudaMemcpyDeviceToHost));
+  REQUIRE(std::memcmp(actual.data(), src.data, num_entries * entry_bytes) == 0);
+}
