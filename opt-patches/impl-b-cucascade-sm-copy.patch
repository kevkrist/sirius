+// =============================================================================
+// SM gather-copy upload engine (flush_h2d kernel path)
+// =============================================================================
+
+namespace {
+
+/// Build a STRING column with `num_strings` rows whose lengths cycle 0..length_cycle-1, chars
+/// filled with a deterministic per-column pattern. The odd total chars size exercises the gather
+/// kernel's tail handling, and the INT32 offsets force a mid-batch flush on reconstruction.
+std::unique_ptr<cudf::column> make_pattern_strings_column(int num_strings,
+                                                          int length_cycle,
+                                                          uint8_t seed,
+                                                          rmm::cuda_stream_view stream,
+                                                          rmm::device_async_resource_ref mr)
+{
+  std::vector<int32_t> offsets;
+  offsets.reserve(static_cast<std::size_t>(num_strings) + 1);
+  offsets.push_back(0);
+  for (int i = 0; i < num_strings; ++i) {
+    offsets.push_back(offsets.back() + (i % length_cycle));
+  }
+  std::vector<uint8_t> chars(static_cast<std::size_t>(offsets.back()));
+  for (std::size_t i = 0; i < chars.size(); ++i) {
+    chars[i] = static_cast<uint8_t>((i * 131 + seed) & 0xFF);
+  }
+
+  rmm::device_buffer offsets_buf(offsets.data(), offsets.size() * sizeof(int32_t), stream, mr);
+  auto offsets_col = std::make_unique<cudf::column>(cudf::data_type{cudf::type_id::INT32},
+                                                    static_cast<cudf::size_type>(offsets.size()),
+                                                    std::move(offsets_buf),
+                                                    rmm::device_buffer{},
+                                                    0);
+  rmm::device_buffer chars_buf(chars.data(), chars.size(), stream, mr);
+  return cudf::make_strings_column(
+    num_strings, std::move(offsets_col), std::move(chars_buf), 0, rmm::device_buffer{});
+}
+
+}  // namespace
+
+// Exercises the SM gather-copy upload path of convert_host_fast_to_gpu end to end. All columns
+// share num_rows = 300'001 rows, chosen so the pin layout hits every kernel copy shape: the
+// leading INT8 column's 300'001-byte buffer aligns up to 300'008, shifting every following
+// buffer to an 8-byte (non-16-byte) phase; the 2.4 MB INT64 column spans three 1 MiB pinned
+// blocks (one multi-entry buffer with phase-mismatched continuation entries); two INT32-offset
+// STRING columns force two mid-batch flushes ahead of the final flush (three kernel flushes
+// total, validating descriptor staging retention across flushes), with odd chars sizes for the
+// sub-word tails; and a nullable column checks that the separate null-mask path still composes
+// correctly.
+TEST_CASE("Round-trip fast: SM gather-copy preserves multi-block, odd-size, multi-flush tables",
+          "[fast][roundtrip][sm_copy]")
+{
+  memory::memory_reservation_manager mgr(create_conversion_test_configs());
+  representation_converter_registry registry;
+  register_builtin_converters(registry);
+
+  const auto* gpu_space  = mgr.get_memory_space(memory::Tier::GPU, 0);
+  const auto* host_space = mgr.get_memory_space(memory::Tier::HOST, 0);
+  rmm::cuda_stream stream;
+  auto mr = gpu_space->get_default_allocator();
+
+  constexpr int num_rows = 300'001;
+
+  std::vector<std::unique_ptr<cudf::column>> cols;
+
+  // col0: INT8, 300'001 bytes -- the odd size phase-shifts every subsequent pin offset.
+  {
+    std::vector<int8_t> host_data(num_rows);
+    for (int i = 0; i < num_rows; ++i) {
+      host_data[i] = static_cast<int8_t>((i * 131 + 17) & 0xFF);
+    }
+    rmm::device_buffer buf(host_data.data(), host_data.size(), stream.view(), mr);
+    cols.push_back(std::make_unique<cudf::column>(
+      cudf::data_type{cudf::type_id::INT8}, num_rows, std::move(buf), rmm::device_buffer{}, 0));
+  }
+
+  // col1: INT64, 2'400'008 bytes, spanning three 1 MiB pinned blocks.
+  {
+    std::vector<int64_t> host_data(num_rows);
+    for (int i = 0; i < num_rows; ++i) {
+      host_data[i] = static_cast<int64_t>(i) * 0x9E3779B97F4A7C15LL + 1;
+    }
+    rmm::device_buffer buf(host_data.data(), host_data.size() * sizeof(int64_t), stream.view(), mr);
+    cols.push_back(std::make_unique<cudf::column>(
+      cudf::data_type{cudf::type_id::INT64}, num_rows, std::move(buf), rmm::device_buffer{}, 0));
+  }
+
+  // col2/col3: STRING columns with distinct length cycles and fill patterns.
+  cols.push_back(make_pattern_strings_column(num_rows, 3, 23, stream.view(), mr));
+  cols.push_back(make_pattern_strings_column(num_rows, 5, 101, stream.view(), mr));
+
+  // col4: nullable INT32 with real nulls.
+  {
+    auto col = cudf::make_numeric_column(cudf::data_type{cudf::type_id::INT32},
+                                         num_rows,
+                                         cudf::mask_state::ALL_VALID,
+                                         stream.view(),
+                                         mr);
+    CUCASCADE_CUDA_TRY(
+      cudaMemsetAsync(col->mutable_view().head(), 0x5C, num_rows * sizeof(int32_t), stream.view()));
+    cudf::set_null_mask(col->mutable_view().null_mask(), 5, 9, false, stream.view());
+    col->set_null_count(4);
+    cols.push_back(std::move(col));
+  }
+  stream.synchronize();
+
+  gpu_table_representation orig_repr(std::make_unique<cudf::table>(std::move(cols)),
+                                     *const_cast<memory::memory_space*>(gpu_space),
+                                     rmm::cuda_stream_view{});
+
+  auto host = fast_convert(orig_repr, host_space, registry, stream.view());
+  stream.synchronize();
+  REQUIRE(host != nullptr);
+
+  auto back = fast_back_convert(*host, gpu_space, registry, stream.view());
+  stream.synchronize();
+  REQUIRE(back != nullptr);
+
+  cucascade::test::expect_cudf_tables_equal_on_stream(
+    orig_repr.get_table_view(), back->get_table_view(), stream.view());
+}
