+// Private-header test: the gather-copy engine is an implementation detail of the cudf converter
+// library, so the header is included by relative path rather than through the public include dir.
+#include "../../src/cudf/batch_gather_copy.cuh"
+
+#include <cucascade/error.hpp>
+
+#include <rmm/cuda_stream.hpp>
+
+#include <cuda_runtime.h>
+
+#include <catch2/catch_all.hpp>
