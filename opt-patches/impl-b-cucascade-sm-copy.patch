+
+#include "batch_gather_copy.cuh"
+
+#include <cucascade/error.hpp>
+
+#include <cuda_runtime.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <cstdlib>
+
+namespace cucascade::detail {
+
+namespace {
+
+/// Threads per block for the gather-copy kernel.
+constexpr int threads_per_block = 256;
+
+/// Full-grid factor: the launch grid is fraction * blocks_per_sm * SM count blocks (see
+/// max_block_fraction), never more than the entry count.
+constexpr int blocks_per_sm = 4;
+
+/**
+ * @brief Returns the grid-size cap fraction for the gather-copy kernel.
+ *
+ * Bounds SM contention with concurrent compute kernels: the launch grid is capped at
+ * max(1, fraction * blocks_per_sm * SM count) blocks. The default of 0.25 (~1 x SM count blocks)
+ * already saturates the host-to-device link -- the copy is bandwidth-bound, not occupancy-bound
+ * (PQ-10 microbench and the in-engine q1/q19 sweep agree) -- while leaving the remaining SMs to
+ * concurrent compute. The environment variable CUCASCADE_SM_COPY_MAX_BLOCK_FRACTION, a float in
+ * [0, 1], overrides it (1.0 = full grid); unset, empty, or unparsable values mean the default;
+ * out-of-range values are clamped. Read once on first use.
+ */
+float max_block_fraction()
+{
+  constexpr float default_fraction = 0.25f;
+  static const float fraction      = [] {
+    const char* raw = std::getenv("CUCASCADE_SM_COPY_MAX_BLOCK_FRACTION");
+    if (raw == nullptr || *raw == '\0') { return default_fraction; }
+    char* end          = nullptr;
+    const float parsed = std::strtof(raw, &end);
+    if (end == raw || !std::isfinite(parsed)) { return default_fraction; }
+    return std::min(1.0f, std::max(parsed, 0.0f));
+  }();
+  return fraction;
+}
+
+/**
+ * @brief Grid-strided gather copy: block b copies entries b, b + gridDim.x, ...
+ *
+ * Each entry is copied with the widest mutually aligned access: when source and destination share
+ * the same 16-byte phase the body streams 16-byte vectors (after peeling at most one 8-byte head
+ * word), otherwise 8-byte words; thread 0 finishes the sub-word tail. A byte loop covers entries
+ * that violate the 8-byte alignment invariant, as a defensive measure.
+ *
+ * Entries are independent and threads within a block touch disjoint bytes of one entry, so the
+ * kernel needs no synchronization.
+ */
+__global__ void gather_copy_kernel(const batch_copy_entry* __restrict__ entries, std::size_t count)
+{
+  for (std::size_t e = blockIdx.x; e < count; e += gridDim.x) {
+    const batch_copy_entry entry = entries[e];
+    const auto* src              = static_cast<const unsigned char*>(entry.src);
+    auto* dst                    = static_cast<unsigned char*>(entry.dst);
+    const std::size_t bytes      = entry.bytes;
+    const auto src_addr          = reinterpret_cast<std::uintptr_t>(src);
+    const auto dst_addr          = reinterpret_cast<std::uintptr_t>(dst);
+
+    if (((src_addr | dst_addr) & 7u) != 0) {
+      for (std::size_t i = threadIdx.x; i < bytes; i += blockDim.x) {
+        dst[i] = src[i];
+      }
+      continue;
+    }
+
+    std::size_t offset = 0;
+    if (((src_addr ^ dst_addr) & 15u) == 0) {
+      if ((src_addr & 15u) != 0 && bytes >= 8) {
+        if (threadIdx.x == 0) {
+          *reinterpret_cast<unsigned long long*>(dst) =
+            *reinterpret_cast<const unsigned long long*>(src);
+        }
+        offset = 8;
+      }
+      const std::size_t num_vecs = (bytes - offset) / sizeof(ulonglong2);
+      const auto* src16          = reinterpret_cast<const ulonglong2*>(src + offset);
+      auto* dst16                = reinterpret_cast<ulonglong2*>(dst + offset);
+      for (std::size_t i = threadIdx.x; i < num_vecs; i += blockDim.x) {
+        dst16[i] = src16[i];
+      }
+      offset += num_vecs * sizeof(ulonglong2);
+    } else {
+      const std::size_t num_words = bytes / 8;
+      const auto* src8            = reinterpret_cast<const unsigned long long*>(src);
+      auto* dst8                  = reinterpret_cast<unsigned long long*>(dst);
+      for (std::size_t i = threadIdx.x; i < num_words; i += blockDim.x) {
+        dst8[i] = src8[i];
+      }
+      offset = num_words * 8;
+    }
+    if (threadIdx.x == 0) {
+      for (std::size_t i = offset; i < bytes; ++i) {
+        dst[i] = src[i];
+      }
+    }
+  }
+}
+
+}  // namespace
+
+void launch_batch_gather_copy(const batch_copy_entry* device_entries,
+                              std::size_t count,
+                              cudaStream_t stream)
+{
+  if (count == 0) { return; }
+  int device = 0;
+  CUCASCADE_CUDA_TRY(cudaGetDevice(&device));
+  int sm_count = 0;
+  CUCASCADE_CUDA_TRY(cudaDeviceGetAttribute(&sm_count, cudaDevAttrMultiProcessorCount, device));
+  const auto full_grid =
+    static_cast<std::size_t>(blocks_per_sm) * static_cast<std::size_t>(sm_count);
+  const auto capped_grid = std::max<std::size_t>(
+    1, static_cast<std::size_t>(max_block_fraction() * static_cast<float>(full_grid)));
+  const auto blocks = static_cast<unsigned int>(std::min(count, capped_grid));
+  gather_copy_kernel<<<blocks, threads_per_block, 0, stream>>>(device_entries, count);
+  CUCASCADE_CUDA_TRY(cudaGetLastError());
+}
+
+}  // namespace cucascade::detail
