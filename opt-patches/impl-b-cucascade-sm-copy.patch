+
+#pragma once
+
+#include <cuda_runtime_api.h>
+
+#include <cstddef>
+
+/**
+ * @file batch_gather_copy.cuh
+ * @brief SM gather-copy upload engine used by the host-to-device flush of BatchCopyAccumulator in
+ * `representation_converter_builtins.cpp`.
+ *
+ * The copy-engine path (cudaMemcpyBatchAsync) tops out well below what the SMs achieve when
+ * reading pinned host memory directly, and it blocks the calling thread while the batch drains.
+ * This engine instead uploads the accumulated (src, dst, bytes) entries as a device-resident
+ * descriptor array and launches one grid-strided kernel that performs every copy, returning to
+ * the caller immediately after enqueue.
+ */
+
+namespace cucascade::detail {
+
+/**
+ * @brief One host-to-device copy operation executed by the gather-copy kernel.
+ *
+ * Mirrors one (dst, src, size) triple accumulated by BatchCopyAccumulator. `src` points into a
+ * pinned host block allocated Portable+Mapped, which unified virtual addressing makes readable
+ * from the GPU at the same address; `dst` points into a device buffer on the launch device. Both
+ * pointers are 8-byte aligned (the pin layout invariant of plan_column_copy); `bytes` is
+ * arbitrary.
+ */
+struct batch_copy_entry {
+  const void* src;    ///< Pinned host source, 8-byte aligned.
+  void* dst;          ///< Device destination, 8-byte aligned.
+  std::size_t bytes;  ///< Copy length in bytes, arbitrary.
+};
+
+/**
+ * @brief Launches a grid-strided gather-copy kernel executing @p count copy entries on @p stream.
+ *
+ * Returns immediately after enqueue; entry sources are read stream-ordered by the kernel, not
+ * captured during this call. The caller therefore owns two lifetime obligations: the
+ * @p device_entries array must stay allocated until the kernel completes (free it stream-ordered
+ * on @p stream after this call), and every entry's source block must remain valid until @p stream
+ * has been synchronized. The launch grid defaults to min(count, ~1 x SM count) blocks -- enough
+ * to saturate the host-to-device link while bounding contention with concurrent compute kernels
+ * -- and is adjustable via the CUCASCADE_SM_COPY_MAX_BLOCK_FRACTION environment knob (see the
+ * launcher).
+ *
+ * @param device_entries Device-resident entry array; must never point at host memory.
+ * @param count Number of entries.
+ * @param stream Stream to launch on; must belong to the current device.
+ */
+void launch_batch_gather_copy(const batch_copy_entry* device_entries,
+                              std::size_t count,
+                              cudaStream_t stream);
+
+}  // namespace cucascade::detail
