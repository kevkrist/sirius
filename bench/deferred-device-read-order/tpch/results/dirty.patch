diff --git a/test/cpp/io/cache/controlled_backend.hpp b/test/cpp/io/cache/controlled_backend.hpp
new file mode 100644
index 00000000..a58292e3
--- /dev/null
+++ b/test/cpp/io/cache/controlled_backend.hpp
@@ -0,0 +1,208 @@
+/*
