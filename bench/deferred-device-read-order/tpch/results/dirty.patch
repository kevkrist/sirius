+  [[nodiscard]] int device() const noexcept { return _device; }
+
+  /**
+   * @brief Append a request if still open; allocation failure leaves the batch unchanged.
+   */
+  [[nodiscard]] bool try_add(slice const& request);
+
+  [[nodiscard]] bool is_open() const;
+
+  /**
+   * @brief Issue registered batches on this stream, wait for this batch, and return the member's
+   * byte count.
+   *
+   * Siblings are issued first so their I/O can overlap a synchronous prefetch wait inside this
+   * batch's issue call. A blocked sibling can conversely delay this batch; this ordering is a
+   * scheduling heuristic. Concurrent member waits share one issuance.
+   */
