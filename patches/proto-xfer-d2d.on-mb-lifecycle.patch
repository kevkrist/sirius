+  /// Offers a replica that was copied through @p route as a relay.
+  void offer(replica_transfer_route route,
+             void const* data,
+             cucascade::memory::memory_space const& space);
+
+ private:
+  bool _enabled;
+  std::vector<origin> _relays;
+};
