+// =============================== DF shape ===============================
+
+// Today (engine HOST_STAGED loop, sirius_dynamic_bloom_filter.cu): star through root 0, one
+// staging window per chunk, a host sync after every leg.
+double sched_today(size_t B, bool blocks, size_t chunk_override)
+{
+  size_t const chunk =
+    chunk_override != 0 ? chunk_override : std::clamp<size_t>(B / 8, 2 * MiB, 8 * MiB);
+  char* const stage = blocks ? hreg : hb[4];
+  for (size_t off = 0; off < B; off += chunk) {
+    size_t const n = std::min(chunk, B - off);
+    for (int s = 1; s < G; ++s) {
+      CK(cudaSetDevice(s));
+      copy_host(dv[s].st[KS], P(s) + off, stage, n, true, blocks);
+      CK(cudaStreamSynchronize(dv[s].st[KS]));
+      CK(cudaSetDevice(0));
+      copy_host(dv[0].st[KS], S(0), stage, n, false, blocks);
+      CK(cudaStreamSynchronize(dv[0].st[KS]));
+      CK(launch_or(P(0) + off, S(0), n, dv[0].st[KS]));
+    }
+    CK(cudaSetDevice(0));
+    copy_host(dv[0].st[KS], P(0) + off, stage, n, true, blocks);
+    CK(cudaStreamSynchronize(dv[0].st[KS]));
+    for (int t = 1; t < G; ++t) {
+      CK(cudaSetDevice(t));
+      copy_host(dv[t].st[KS], P(t) + off, stage, n, false, blocks);
+    }
+    for (int t = 1; t < G; ++t) {
+      CK(cudaSetDevice(t));
+      CK(cudaStreamSynchronize(dv[t].st[KS]));
+    }
+  }
+  sync_streams();
+  return -1;
+}
+
+// The engine's PEER_COPY pipeline (chunk_pipeline): star through root 0, cudaMemcpyPeerAsync on
+// every leg, two scratch slots per source, event-chained, one final wait. With Gn == 4 on this
+// machine the cross-pair legs are staged by the driver.
+double sched_star_peer(int Gn, size_t B, size_t chunk, int K)
+{
+  ev_t fr[3][4]{};
+  double const t0 = now_ms();
+  size_t i        = 0;
+  for (size_t off = 0; off < B; off += chunk, ++i) {
+    size_t const n = std::min(chunk, B - off);
+    int const j    = static_cast<int>(i % static_cast<size_t>(K));
+    ev_t last      = nullptr;
+    for (int s = 1; s < Gn; ++s) {
+      char* const slot = S(0) + (static_cast<size_t>(s - 1) * K + j) * chunk;
+      ev_t const e     = op_p2p(0, RX, slot, s, P(s) + off, n, {fr[s - 1][j]});
+      last             = op_or(0, KS, P(0) + off, slot, n, {e});
+      fr[s - 1][j]     = last;
+    }
+    for (int t = 1; t < Gn; ++t) { op_p2p(t, RX, P(t) + off, 0, P(0) + off, n, {last}); }
+  }
+  double const sub = now_ms() - t0;
+  sync_streams();
+  return sub;
+}
+
+// Same star, explicit host bounce on every leg, pipelined (no P2P anywhere, OR on the root GPU).
+double sched_star_pipe(size_t B, size_t chunk, int K)
+{
+  static const int rxs[3] = {RX, RX2, AUX};
+  ev_t inf[3][4]{}, sf[3][4]{}, rf[4][3]{};
+  double const t0 = now_ms();
+  size_t i        = 0;
+  for (size_t off = 0; off < B; off += chunk, ++i) {
+    size_t const n = std::min(chunk, B - off);
+    int const j    = static_cast<int>(i % static_cast<size_t>(K));
+    ev_t last      = nullptr;
+    for (int s = 1; s < G; ++s) {
+      int const si     = s - 1;
+      char* const hs   = hb[s] + j * chunk;
+      char* const slot = S(0) + (static_cast<size_t>(si) * K + j) * chunk;
+      ev_t const e1    = op_d2h(s, TX, hs, P(s) + off, n, {inf[si][j]});
+      ev_t const e2    = op_h2d(0, rxs[si], slot, hs, n, {e1, sf[si][j]});
+      inf[si][j]       = e2;
+      last             = op_or(0, KS, P(0) + off, slot, n, {e2});
+      sf[si][j]        = last;
+    }
+    char* const hr = hb[0] + j * chunk;
+    ev_t const er  = op_d2h(0, TX, hr, P(0) + off, n, {last, rf[j][0], rf[j][1], rf[j][2]});
+    for (int t = 1; t < G; ++t) { rf[j][t - 1] = op_h2d(t, RX, P(t) + off, hr, n, {er}); }
+  }
+  double const sub = now_ms() - t0;
+  sync_streams();
+  return sub;
+}
+
+// Hypercube all-reduce: round 1 exchanges inside the pairs (g <-> g^1), round 2 across the pairs
+// (g <-> g^2). Every GPU ORs what it receives into its own array; nobody is a root.
+double sched_hyper(int Gn, size_t B, size_t chunk, int K, transport r1, transport r2)
+{
+  ev_t af[4][4]{}, bf[4][4]{}, h1[4][4]{}, h2[4][4]{};
+  double const t0 = now_ms();
+  size_t i        = 0;
+  for (size_t off = 0; off < B; off += chunk, ++i) {
+    size_t const n = std::min(chunk, B - off);
+    int const j    = static_cast<int>(i % static_cast<size_t>(K));
+    ev_t in1[4]{}, or1[4]{}, in2[4]{};
+    for (int g = 0; g < Gn; ++g) {
+      int const p = g ^ 1;
+      in1[g] = xfer(r1, g, RX, S(g) + j * chunk, p, TX, P(p) + off, n, {}, {af[g][j]},
+                    hb[g] + j * chunk, &h1[g][j]);
+    }
+    for (int g = 0; g < Gn; ++g) {
+      or1[g]   = op_or(g, KS, P(g) + off, S(g) + j * chunk, n, {in1[g], in1[g ^ 1]});
+      af[g][j] = or1[g];
+    }
+    if (Gn == 4) {
+      for (int g = 0; g < Gn; ++g) {
+        int const p = g ^ 2;
+        in2[g] = xfer(r2, g, RX2, S(g) + static_cast<size_t>(K + j) * chunk, p, TX2, P(p) + off, n,
+                      {or1[p]}, {bf[g][j]}, hb[g] + static_cast<size_t>(K + j) * chunk, &h2[g][j]);
+      }
+      for (int g = 0; g < Gn; ++g) {
+        bf[g][j] = op_or(g, KS2, P(g) + off, S(g) + static_cast<size_t>(K + j) * chunk, n,
+                         {in2[g], in2[g ^ 2], or1[g]});
+      }
+    }
+  }
+  double const sub = now_ms() - t0;
+  sync_streams();
+  return sub;
+}
+
+// Pair-local P2P merge (1 -> 0, 3 -> 2), symmetric cross-pair exchange 0 <-> 2 (bounce or peer
+// API), then P2P fan-out 0 -> 1 and 2 -> 3.
+double sched_c2(size_t B, size_t chunk, int K, transport r2)
+{
+  ev_t af[4][4]{}, bf[4][4]{}, hf[4][4]{};
+  double const t0 = now_ms();
+  size_t i        = 0;
+  for (size_t off = 0; off < B; off += chunk, ++i) {
+    size_t const n = std::min(chunk, B - off);
+    int const j    = static_cast<int>(i % static_cast<size_t>(K));
+    ev_t or1[4]{}, in2[4]{}, or2[4]{};
+    for (int r : {0, 2}) {
+      char* const slot = S(r) + j * chunk;
+      ev_t const e     = op_p2p(r, RX, slot, r + 1, P(r + 1) + off, n, {af[r][j]});
+      or1[r]           = op_or(r, KS, P(r) + off, slot, n, {e});
+      af[r][j]         = or1[r];
+    }
+    for (int r : {0, 2}) {
+      int const p = r ^ 2;
+      in2[r] = xfer(r2, r, RX2, S(r) + static_cast<size_t>(K + j) * chunk, p, TX, P(p) + off, n,
+                    {or1[p]}, {bf[r][j]}, hb[r] + j * chunk, &hf[r][j]);
+    }
+    for (int r : {0, 2}) {
+      or2[r]   = op_or(r, KS2, P(r) + off, S(r) + static_cast<size_t>(K + j) * chunk, n,
+                       {in2[r], in2[r ^ 2], or1[r]});
+      bf[r][j] = or2[r];
+    }
+    for (int r : {0, 2}) { op_p2p(r + 1, RX, P(r + 1) + off, r, P(r) + off, n, {or2[r]}); }
+  }
+  double const sub = now_ms() - t0;
+  sync_streams();
+  return sub;
+}
+
+// The schedule as literally proposed: pair-local P2P merge, ONE cross-pair bounce 2 -> 0, then
+// fan-out 0 -> 1 by P2P and 0 -> host once -> 2, and 2 -> 3 by P2P (relay) or host -> 3.
+double sched_c1(size_t B, size_t chunk, int K, bool relay)
+{
+  ev_t af[4][4]{}, bf[4]{}, hf2[4]{}, f2[4]{}, f3[4]{};
+  double const t0 = now_ms();
+  size_t i        = 0;
+  for (size_t off = 0; off < B; off += chunk, ++i) {
+    size_t const n = std::min(chunk, B - off);
+    int const j    = static_cast<int>(i % static_cast<size_t>(K));
+    ev_t or1[4]{};
+    for (int r : {0, 2}) {
+      char* const slot = S(r) + j * chunk;
+      ev_t const e     = op_p2p(r, RX, slot, r + 1, P(r + 1) + off, n, {af[r][j]});
+      or1[r]           = op_or(r, KS, P(r) + off, slot, n, {e});
+      af[r][j]         = or1[r];
+    }
+    char* const slot2 = S(0) + static_cast<size_t>(K + j) * chunk;
+    ev_t const eb = xfer(BOUNCE, 0, RX2, slot2, 2, TX, P(2) + off, n, {or1[2]}, {bf[j]},
+                         hb[2] + j * chunk, &hf2[j]);
+    ev_t const ef = op_or(0, KS2, P(0) + off, slot2, n, {eb, or1[0]});
+    bf[j]         = ef;
+    op_p2p(1, RX, P(1) + off, 0, P(0) + off, n, {ef});
+    char* const hs = hb[0] + j * chunk;
+    ev_t const eF  = op_d2h(0, TX, hs, P(0) + off, n, {ef, f2[j], f3[j]});
+    ev_t const e2  = op_h2d(2, RX2, P(2) + off, hs, n, {eF});
+    f2[j]          = e2;
+    if (relay) {
+      op_p2p(3, RX2, P(3) + off, 2, P(2) + off, n, {e2});
+    } else {
+      f3[j] = op_h2d(3, RX2, P(3) + off, hs, n, {eF});
+    }
+  }
+  double const sub = now_ms() - t0;
+  sync_streams();
+  return sub;
+}
+
+// Host OR, three synced phases: all D2H in parallel, OR on the CPU, all H2D in parallel.
+double sched_hostor_3phase(size_t B, int nt)
+{
+  for (int g = 0; g < G; ++g) { op_d2h(g, TX, hb[g], P(g), B); }
+  for (int g = 0; g < G; ++g) { sync_stream(g, TX); }
+  char* in[4] = {hb[0], hb[1], hb[2], hb[3]};
+  host_or(hb[4], in, G, B, nt);
+  for (int g = 0; g < G; ++g) { op_h2d(g, RX, P(g), hb[4], B); }
+  for (int g = 0; g < G; ++g) { sync_stream(g, RX); }
+  return -1;
+}
+
+// Host OR, pipelined per chunk: every D2H is queued up front; the host waits for chunk i from
+// all GPUs, ORs it, and queues its four uploads while later chunks are still downloading.
+double sched_hostor_pipe(size_t B, size_t chunk, int nt)
+{
+  size_t const nch = (B + chunk - 1) / chunk;
+  std::vector<ev_t> ev(static_cast<size_t>(G) * nch);
+  double const t0 = now_ms();
+  for (int g = 0; g < G; ++g) {
+    for (size_t i = 0; i < nch; ++i) {
+      size_t const off = i * chunk;
+      ev[static_cast<size_t>(g) * nch + i] =
+        op_d2h(g, TX, hb[g] + off, P(g) + off, std::min(chunk, B - off));
+    }
+  }
+  double const sub = now_ms() - t0;
+  for (size_t i = 0; i < nch; ++i) {
+    size_t const off = i * chunk;
+    size_t const n   = std::min(chunk, B - off);
+    char* in[4];
+    for (int g = 0; g < G; ++g) {
+      CK(cudaSetDevice(g));
+      CK(cudaEventSynchronize(ev[static_cast<size_t>(g) * nch + i]));
+      in[g] = hb[g] + off;
+    }
+    host_or(hb[4] + off, in, G, n, nt);
+    for (int g = 0; g < G; ++g) { op_h2d(g, RX, P(g) + off, hb[4] + off, n); }
+  }
+  for (int g = 0; g < G; ++g) { sync_stream(g, RX); }
+  return sub;
+}
+
+// Pair-local P2P merge on the GPUs, then host OR of the two pair results, uploads to all four.
+double sched_pairhostor_pipe(size_t B, size_t chunk, int K, int nt)
+{
+  size_t const nch = (B + chunk - 1) / chunk;
+  std::vector<ev_t> ev(2 * nch);
+  ev_t af[4][4]{};
+  double const t0 = now_ms();
+  for (size_t i = 0; i < nch; ++i) {
+    size_t const off = i * chunk;
+    size_t const n   = std::min(chunk, B - off);
+    int const j      = static_cast<int>(i % static_cast<size_t>(K));
+    for (int r : {0, 2}) {
+      char* const slot = S(r) + j * chunk;
+      ev_t const e     = op_p2p(r, RX, slot, r + 1, P(r + 1) + off, n, {af[r][j]});
+      ev_t const o     = op_or(r, KS, P(r) + off, slot, n, {e});
+      af[r][j]         = o;
+      ev[static_cast<size_t>(r / 2) * nch + i] = op_d2h(r, TX, hb[r] + off, P(r) + off, n, {o});
+    }
+  }
+  double const sub = now_ms() - t0;
+  for (size_t i = 0; i < nch; ++i) {
+    size_t const off = i * chunk;
+    size_t const n   = std::min(chunk, B - off);
+    char* in[2];
+    for (int r : {0, 2}) {
+      CK(cudaSetDevice(r));
+      CK(cudaEventSynchronize(ev[static_cast<size_t>(r / 2) * nch + i]));
+      in[r / 2] = hb[r] + off;
+    }
+    host_or(hb[4] + off, in, 2, n, nt);
+    for (int g = 0; g < G; ++g) { op_h2d(g, RX2, P(g) + off, hb[4] + off, n); }
+  }
+  sync_streams();
+  return sub;
+}
+
+void run_df(size_t B, std::string const& sfx, int mode)
+{
+  uint64_t salt   = 0;
+  auto const prep = [&](int) {
+    salt = ++g_salt;
+    for (int g = 0; g < G; ++g) { fill(g, P(g), B, 1u << g, salt); }
+  };
+  auto const ver4 = [&]() -> unsigned long long {
+    unsigned long long m = 0;
+    for (int g = 0; g < G; ++g) { m += verify(g, P(g), B, 0xFu, salt); }
+    return m;
+  };
+  auto const ver2 = [&]() -> unsigned long long {
+    return verify(0, P(0), B, 0x3u, salt) + verify(1, P(1), B, 0x3u, salt);
+  };
+  auto go = [&](std::string const& nm, std::function<double()> const& fn, bool pair = false) {
+    result_t st = measure(nm.c_str(), g_reps, prep, fn,
+                      pair ? std::function<unsigned long long()>(ver2)
+                           : std::function<unsigned long long()>(ver4));
+    report("df", "B=" + mib(B) + "|" + nm + sfx, B, st);
+  };
+  size_t const c8 = 8 * MiB, c32 = 32 * MiB, c64 = 64 * MiB, c256 = 256 * MiB;
+  if (mode == 2) {  // leg-size / robustness set for the contention follow-up
+    if (B <= 300 * MiB) { go("today|blk=1m_batch", [&] { return sched_today(B, true, 0); }); }
+    go("c2|r2=bounce|chunk=32", [&] { return sched_c2(B, c32, 2, BOUNCE); });
+    go("c2|r2=bounce|chunk=256", [&] { return sched_c2(B, c256, 2, BOUNCE); });
+    go("c2|r2=bounce|chunk=whole", [&] { return sched_c2(B, B, 1, BOUNCE); });
+    go("c1|fan=relay|chunk=whole", [&] { return sched_c1(B, B, 1, true); });
+    go("hostor_pipe|chunk=32|threads=16", [&] { return sched_hostor_pipe(B, c32, 16); });
+    go("hostor_pipe|chunk=256|threads=16", [&] { return sched_hostor_pipe(B, c256, 16); });
+    go("hostor_3phase|threads=16", [&] { return sched_hostor_3phase(B, 16); });
+    go("pairhostor_pipe|chunk=32|threads=16", [&] { return sched_pairhostor_pipe(B, c32, 2, 16); });
+    go("pairhostor_pipe|chunk=whole|threads=16",
+       [&] { return sched_pairhostor_pipe(B, B, 1, 16); });
+    return;
+  }
+  go("today|blk=1m_batch", [&] { return sched_today(B, true, 0); });
+  go("hyper|r1=p2p|r2=bounce|chunk=32", [&] { return sched_hyper(4, B, c32, 2, PEERAPI, BOUNCE); });
+  go("c2|r2=bounce|chunk=32", [&] { return sched_c2(B, c32, 2, BOUNCE); });
+  go("hostor_pipe|chunk=32|threads=16", [&] { return sched_hostor_pipe(B, c32, 16); });
+  go("star_peerapi|chunk=8", [&] { return sched_star_peer(4, B, c8, 2); });
+  if (mode == 1) { return; }
+  go("today|blk=contig", [&] { return sched_today(B, false, 0); });
+  go("today|blk=contig|chunk=64", [&] { return sched_today(B, false, c64); });
+  go("star_peerapi|chunk=32", [&] { return sched_star_peer(4, B, c32, 2); });
+  go("star_pipe|chunk=8", [&] { return sched_star_pipe(B, c8, 2); });
+  go("star_pipe|chunk=32", [&] { return sched_star_pipe(B, c32, 2); });
+  go("c1|fan=relay|chunk=32", [&] { return sched_c1(B, c32, 2, true); });
+  go("c1|fan=host3|chunk=32", [&] { return sched_c1(B, c32, 2, false); });
+  go("c2|r2=bounce|chunk=8", [&] { return sched_c2(B, c8, 2, BOUNCE); });
+  go("c2|r2=bounce|chunk=64", [&] { return sched_c2(B, c64, 2, BOUNCE); });
+  go("c2|r2=peerapi|chunk=32", [&] { return sched_c2(B, c32, 2, PEERAPI); });
+  go("hyper|r1=p2p|r2=bounce|chunk=8", [&] { return sched_hyper(4, B, c8, 2, PEERAPI, BOUNCE); });
+  go("hyper|r1=p2p|r2=bounce|chunk=64", [&] { return sched_hyper(4, B, c64, 2, PEERAPI, BOUNCE); });
+  go("hyper|r1=p2p|r2=peerapi|chunk=32",
+     [&] { return sched_hyper(4, B, c32, 2, PEERAPI, PEERAPI); });
+  go("hyper|r1=bounce|r2=bounce|chunk=32",
+     [&] { return sched_hyper(4, B, c32, 2, BOUNCE, BOUNCE); });
+  go("hostor_3phase|threads=16", [&] { return sched_hostor_3phase(B, 16); });
+  go("hostor_pipe|chunk=8|threads=16", [&] { return sched_hostor_pipe(B, c8, 16); });
+  go("hostor_pipe|chunk=64|threads=16", [&] { return sched_hostor_pipe(B, c64, 16); });
+  go("hostor_pipe|chunk=32|threads=4", [&] { return sched_hostor_pipe(B, c32, 4); });
+  go("hostor_pipe|chunk=32|threads=8", [&] { return sched_hostor_pipe(B, c32, 8); });
+  go("hostor_pipe|chunk=32|threads=32", [&] { return sched_hostor_pipe(B, c32, 32); });
+  go("pairhostor_pipe|chunk=32|threads=16", [&] { return sched_pairhostor_pipe(B, c32, 2, 16); });
+  // G = 2 references on the P2P pair (0, 1): the engine's PEER pipeline and a duplex exchange.
+  go("pair01_star_peer|chunk=8", [&] { return sched_star_peer(2, B, c8, 2); }, true);
+  go("pair01_star_peer|chunk=32", [&] { return sched_star_peer(2, B, c32, 2); }, true);
+  go("pair01_exchange|chunk=8", [&] { return sched_hyper(2, B, c8, 2, PEERAPI, PEERAPI); }, true);
+  go("pair01_exchange|chunk=32", [&] { return sched_hyper(2, B, c32, 2, PEERAPI, PEERAPI); },
+     true);
+  go("pair01_exchange_bounce|chunk=32",
+     [&] { return sched_hyper(2, B, c32, 2, BOUNCE, BOUNCE); }, true);
+}
+
+// =============================== contention ===============================
+
+void test_cont(std::vector<size_t> const& dfsizes, int dfmode, bool legs,
+               std::vector<int> const& modes)
+{
+  for (int mode : modes) {
+    std::atomic<bool> stop{false};
+    std::atomic<uint64_t> bytes_p2p{0}, bytes_host{0};
+    std::vector<std::thread> th;
+    if ((mode & 1) != 0) {  // P2P 0 -> 1, whole buffers, back to back
+      th.emplace_back([&] {
+        while (!stop.load()) {
+          CK(cudaSetDevice(1));
+          CK(cudaMemcpyPeerAsync(dv[1].buf[BG], 1, dv[0].buf[BG], 0, g_bgleg, dv[1].st[AUX2]));
+          CK(cudaStreamSynchronize(dv[1].st[AUX2]));
+          bytes_p2p += g_bgleg;
+        }
+      });
+    }
+    if ((mode & 2) != 0) {  // host-staged 0 -> 2: whole D2H, then whole H2D (cuCascade's shape)
+      th.emplace_back([&] {
+        while (!stop.load()) {
+          CK(cudaSetDevice(0));
+          CK(cudaMemcpyAsync(hb[5], dv[0].buf[RPART], g_bgleg, cudaMemcpyDeviceToHost,
+                             dv[0].st[AUX2]));
+          CK(cudaStreamSynchronize(dv[0].st[AUX2]));
+          CK(cudaSetDevice(2));
+          CK(cudaMemcpyAsync(dv[2].buf[BG], hb[5], g_bgleg, cudaMemcpyHostToDevice,
+                             dv[2].st[AUX2]));
+          CK(cudaStreamSynchronize(dv[2].st[AUX2]));
+          bytes_host += g_bgleg;
+        }
+      });
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(100));
+    double const t0       = now_ms();
+    std::string const sfx = std::string("|bg=") + (mode == 0   ? "none"
+                                                   : mode == 1 ? "p2p01"
+                                                   : mode == 2 ? "host02"
+                                                               : "p2p01+host02") +
+                            "|bgleg=" + mib(g_bgleg);
+    for (size_t B : dfsizes) { run_df(B, sfx, dfmode); }
+    size_t const n = BMAX;
+    if (legs) {
+    run_legs("cont", "n=" + mib(n) + "|p2p:01" + sfx, {Pp(0, 1)}, n);
+    run_legs("cont", "n=" + mib(n) + "|p2p:23" + sfx, {Pp(2, 3)}, n);
+    run_legs("cont", "n=" + mib(n) + "|bounce:02" + sfx, {Bb(0, 2, 0)}, n);
+    run_legs("cont", "n=" + mib(n) + "|bounce:13" + sfx, {Bb(1, 3, 1)}, n);
+    }
+    double const el = (now_ms() - t0) / 1000.0;
+    stop.store(true);
+    for (auto& t : th) { t.join(); }
+    std::printf("I|cont|%s|bg_p2p_gibps=%.2f|bg_host_gibps=%.2f\n", sfx.c_str() + 1,
+                static_cast<double>(bytes_p2p.load()) / static_cast<double>(1ull << 30) / el,
+                static_cast<double>(bytes_host.load()) / static_cast<double>(1ull << 30) / el);
+    std::fflush(stdout);
+    sync_all();
+  }
+}
+
+std::vector<size_t> parse_sizes(std::string const& s)
+{
+  std::vector<size_t> out;
+  size_t pos = 0;
+  while (pos < s.size()) {
+    size_t const end = s.find(',', pos);
+    std::string const tok = s.substr(pos, end == std::string::npos ? std::string::npos : end - pos);
+    if (!tok.empty()) { out.push_back(static_cast<size_t>(std::stoull(tok)) * MiB); }
+    if (end == std::string::npos) { break; }
+    pos = end + 1;
+  }
+  return out;
+}
+
+bool has(std::string const& tests, char const* t)
+{
+  return ("," + tests + ",").find(std::string(",") + t + ",") != std::string::npos;
+}
+
+}  // namespace
+
+int main(int argc, char** argv)
+{
+  std::string tests = "leg,pair,fan,hostor,conc,df,cont";
+  std::vector<size_t> sizes   = parse_sizes("8,64,256,1434");
+  std::vector<size_t> dfsizes = parse_sizes("57,281,1434");
+  std::vector<size_t> fansizes = parse_sizes("1,16,281,1434");
+  bool pair_all = true;
+  for (int i = 1; i < argc; ++i) {
+    std::string const a = argv[i];
+    size_t const eq     = a.find('=');
+    if (eq == std::string::npos) { continue; }
+    std::string const k = a.substr(0, eq), v = a.substr(eq + 1);
+    if (k == "tests") {
+      tests = v;
+    } else if (k == "sizes") {
+      sizes = parse_sizes(v);
+    } else if (k == "dfsizes") {
+      dfsizes = parse_sizes(v);
+    } else if (k == "fansizes") {
+      fansizes = parse_sizes(v);
+    } else if (k == "reps") {
+      g_reps = std::max(1, std::atoi(v.c_str()));
+    } else if (k == "bmax") {
+      BMAX = static_cast<size_t>(std::stoull(v)) * MiB;
+    } else if (k == "bgleg") {
+      g_bgleg = static_cast<size_t>(std::stoull(v)) * MiB;
+    } else if (k == "nopeer") {
+      g_nopeer = v != "0";
+    } else if (k == "probe") {
+      g_probe = v != "0";
+    } else if (k == "pairmethods") {
+      pair_all = v != "peer";
+    }
+  }
+  HSZ = std::max(2 * BMAX, 512 * MiB);  // room for whole-array scratch slots
+  if (g_bgleg == 0) { g_bgleg = BMAX; }
+  setup();
+  if (G < 4) {
+    std::fprintf(stderr, "needs 4 GPUs\n");
+    return 1;
+  }
+  if (has(tests, "leg")) { test_leg(sizes); }
+  if (has(tests, "pair")) { test_pair(sizes, pair_all); }
+  if (has(tests, "fan")) { test_fan(fansizes); }
+  if (has(tests, "hostor")) { test_hostor({32 * MiB, std::min(BMAX, 1434 * MiB)}); }
+  if (has(tests, "conc")) { test_conc({std::min<size_t>(256 * MiB, BMAX), BMAX}); }
+  if (has(tests, "df")) {
+    for (size_t B : dfsizes) { run_df(B, "", 0); }
+  }
+  if (has(tests, "cont")) { test_cont(dfsizes, 1, true, {0, 1, 2, 3}); }
+  if (has(tests, "cont2")) {
+    test_cont(dfsizes, 2, false, {0, 2, 3});
+    g_bgleg = 64 * MiB;
+    test_cont(dfsizes, 2, false, {2, 3});
+  }
+  std::printf("I|done\n");
+  return 0;
+}
