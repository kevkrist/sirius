+void test_hostor(std::vector<size_t> const& sizes)
+{
+  for (size_t n : sizes) {
+    for (int nin : {2, 4}) {
+      for (int nt : {1, 2, 4, 8, 16, 32, 48}) {
+        std::vector<double> t;
+        char* in[4] = {hb[0], hb[1], hb[2], hb[3]};
+        for (int r = 0; r <= g_reps; ++r) {
