+#!/bin/bash
+# Follow-up pass: rebuild, then leg-size robustness under background copies (tests=cont2).
+R=/opt/dlami/nvme/dfperf; M=$R/runs/mb_xfer; B=$M/bin/xfer_bench
+export TMPDIR=$R/tmp
+cd $M
+[ -f out/.ok_cont2 ] && exit 0
+$R/wt-mb-xfer/bench/transfer/build.sh > out/build2.log 2>&1 || { echo "build failed"; grep -E 'error' out/build2.log | head -30; exit 10; }
+tail -1 out/build2.log
+timeout 1500 $B tests=cont2 dfsizes=281,1434 reps=3 > out/cont2.log 2> out/cont2.err; rc=$?
+echo "cont2 rc=$rc lines=$(wc -l < out/cont2.log)"; [ $rc -eq 0 ] && touch out/.ok_cont2
diff --git a/bench/transfer/tab.py b/bench/transfer/tab.py
new file mode 100644
index 00000000..5f26f3f8
--- /dev/null
+++ b/bench/transfer/tab.py
@@ -0,0 +1,156 @@
+#!/usr/bin/env python3
+"""Tables from xfer_bench "R|test|name...|key=value|..." lines.
+
+usage: tab.py LOG leg|pair|fan|hostor|conc|df|cont [substring filter ...]
+"""
+import statistics
+import sys
+from collections import defaultdict
+
+
+def parse(path):
+    rows = []
+    for line in open(path):
+        if not line.startswith("R|"):
+            continue
+        parts = line.rstrip("\n").split("|")
+        row = {"test": parts[1], "tags": [], "kv": {}}
+        for p in parts[2:]:
+            if "=" in p and not p.startswith("p2p:") and ":" not in p.split("=")[0]:
+                k, v = p.split("=", 1)
+                row["kv"][k] = v
+            else:
+                row["tags"].append(p)
+        rows.append(row)
+    return rows
+
+
+def f(row, key, default=float("nan")):
+    try:
+        return float(row["kv"][key])
+    except (KeyError, ValueError):
+        return default
+
+
+def name(row, skip=()):
+    keys = [k for k in row["kv"] if k not in (
+        "bytes", "med_ms", "min_ms", "max_ms", "gibps", "ms_per_gib", "submit_ms", "mism", "reps",
+        "legs", "agg_gibps", "leg_gibps", "ERR") and k not in skip]
+    return " ".join(row["tags"] + [f"{k}={row['kv'][k]}" for k in keys])
+
+
+def leg(rows):
+    # GiB/s per (kind, n): median over the 4 GPUs, with range.
+    acc = defaultdict(list)
+    for r in rows:
+        nm = " ".join(t for t in r["tags"] if not t.startswith("g")) + " " + " ".join(
+            f"{k}={r['kv'][k]}" for k in ("host", "dev", "chunk", "blk") if k in r["kv"])
+        acc[(nm, int(r["kv"]["n"]))].append(f(r, "gibps"))
+    sizes = sorted({k[1] for k in acc})
+    print("| leg | " + " | ".join(f"{s} MiB" for s in sizes) + " |")
+    print("|---|" + "---|" * len(sizes))
+    for nm in dict.fromkeys(k[0] for k in acc):
+        cells = []
+        for s in sizes:
+            v = acc.get((nm, s))
+            cells.append(f"{statistics.median(v):.1f} ({min(v):.1f}-{max(v):.1f})" if v else "-")
+        print(f"| {nm} | " + " | ".join(cells) + " |")
+
+
+def pair(rows):
+    acc = defaultdict(list)
+    bad = defaultdict(int)
+    sub = defaultdict(list)
+    for r in rows:
+        nm = name(r, skip=("p2p", "n"))
+        nm = " ".join(t for t in nm.split(" ") if ">" not in t)
+        key = (nm, "P2P pairs" if r["kv"].get("p2p") == "1" else "cross pairs", int(r["kv"]["n"]))
+        if "ERR" in r["kv"]:
+            bad[key] += 1
+            continue
+        acc[key].append(f(r, "gibps"))
+        sub[key].append(f(r, "submit_ms"))
+        if r["kv"].get("mism", "0") != "0":
+            bad[key] += 1
+    sizes = sorted({k[2] for k in list(acc) + list(bad)})
+    for cls in ("P2P pairs", "cross pairs"):
+        print(f"\n**{cls}** GiB/s, median over ordered pairs (min-max) [pairs]; '!' = wrong bytes or error\n")
+        print("| method | " + " | ".join(f"{s} MiB" for s in sizes) + " |")
+        print("|---|" + "---|" * len(sizes))
+        for nm in dict.fromkeys(k[0] for k in list(acc) + list(bad)):
+            cells = []
+            for s in sizes:
+                v = acc.get((nm, cls, s))
+                b = bad.get((nm, cls, s), 0)
+                if v:
+                    cells.append(f"{statistics.median(v):.1f} ({min(v):.1f}-{max(v):.1f}) [{len(v)}]" +
+                                 (f" !{b}" if b else ""))
+                else:
+                    cells.append(f"!{b}" if b else "-")
+            if any(c != "-" for c in cells):
+                print(f"| {nm} | " + " | ".join(cells) + " |")
+
+
+def listing(rows, cols):
+    print("| config | " + " | ".join(cols) + " |")
+    print("|---|" + "---|" * len(cols))
+    for r in rows:
+        if "ERR" in r["kv"]:
+            print(f"| {name(r)} | ERR {r['kv']['ERR']} |")
+            continue
+        print(f"| {name(r)} | " + " | ".join(r["kv"].get(c, "-") for c in cols) + " |")
+
+
+def df(rows):
+    # one row per schedule, columns per B: ms (ms/GiB)
+    acc = {}
+    sizes = []
+    for r in rows:
+        b = int(r["kv"]["B"])
+        if b not in sizes:
+            sizes.append(b)
+        nm = name(r, skip=("B",))
+        if "ERR" in r["kv"]:
+            acc[(nm, b)] = "ERR"
+        else:
+            flag = "" if r["kv"].get("mism", "0") == "0" else " !WRONG"
+            acc[(nm, b)] = (f"{f(r, 'med_ms'):.1f} [{f(r, 'min_ms'):.1f}-{f(r, 'max_ms'):.1f}] "
+                            f"({f(r, 'ms_per_gib'):.0f}){flag}")
+    print("| schedule | " + " | ".join(f"B={s} MiB: ms [min-max] (ms/GiB)" for s in sizes) + " |")
+    print("|---|" + "---|" * len(sizes))
+    for nm in dict.fromkeys(k[0] for k in acc):
+        print(f"| {nm} | " + " | ".join(acc.get((nm, s), "-") for s in sizes) + " |")
+
+
+def main():
+    path, what = sys.argv[1], sys.argv[2]
+    filters = sys.argv[3:]
+    allrows = parse(path)
+    if what == "df":
+        rows = [r for r in allrows if r["test"] == "df" and "bg" not in r["kv"]]
+    elif what == "cont":
+        rows = [r for r in allrows if r["test"] == "cont" or (r["test"] == "df" and "bg" in r["kv"])]
+    else:
+        rows = [r for r in allrows if r["test"] == what]
+    if filters:
+        rows = [r for r in rows if all(x in "|".join(r["tags"] + [f"{k}={v}" for k, v in r["kv"].items()])
+                                       for x in filters)]
+    if what == "leg":
+        leg(rows)
+    elif what == "pair":
+        pair(rows)
+    elif what in ("df",):
+        df(rows)
+    elif what == "conc":
+        listing(rows, ["med_ms", "agg_gibps", "leg_gibps"])
+    elif what == "cont":
+        legs = [r for r in rows if "legs" in r["kv"]]
+        df([r for r in rows if "legs" not in r["kv"]])
+        if legs:
+            listing(legs, ["med_ms", "agg_gibps", "leg_gibps"])
+    else:
+        listing(rows, ["med_ms", "min_ms", "max_ms", "gibps", "ms_per_gib", "submit_ms", "mism"])
+
+
+if __name__ == "__main__":
+    main()
diff --git a/bench/transfer/xfer_bench.cpp b/bench/transfer/xfer_bench.cpp
new file mode 100644
index 00000000..1b56e67a
--- /dev/null
+++ b/bench/transfer/xfer_bench.cpp
@@ -0,0 +1,1493 @@
+// Transfer-primitive microbenchmark for the dynamic-filter finish chain (prototype tooling).
+//
+// Standalone: raw CUDA + (optionally) rmm::mr::cuda_async_memory_resource for the device pools,
+// no engine code. Measures, on the visible GPUs:
+//   topo   peer matrix / P2P attributes
+//   leg    D2H and H2D link rates per device (pinned / registered / THP / pageable host memory)
+//   pair   every ordered GPU pair: cudaMemcpyPeerAsync, host staging synced per leg (today's
+//          engine shape), pipelined host staging
+//   fan    one root to three targets (replica copies)
+//   hostor multi-threaded AVX-512 OR on the host
+//   conc   several legs at once (aggregate throughput)
+//   df     the Bloom finish shape end to end: G = 4, every GPU holds a partial, all GPUs end with
+//          the OR of all partials. Today's star with serial synced legs vs alternative schedules
+//   cont   df + legs while an unrelated heavy cross-GPU copy runs
+//
+// Output: one "R|test|name|key=value|..." line per configuration (parsed by tab.py).
+// GiB = 2^30 bytes everywhere.
+
+#include <cuda_runtime.h>
+
+#include <immintrin.h>
+#include <omp.h>
+#include <sys/mman.h>
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <functional>
+#include <initializer_list>
+#include <memory>
+#include <string>
+#include <thread>
+#include <vector>
+
+#ifdef USE_RMM
+#include <rmm/mr/cuda_async_memory_resource.hpp>
+#endif
+
+#if __has_include(<nvtx3/nvToolsExt.h>)
+#include <nvtx3/nvToolsExt.h>
+#define NVTX_PUSH(name) nvtxRangePushA(name)
+#define NVTX_POP()      nvtxRangePop()
+#else
+#define NVTX_PUSH(name) (void)0
+#define NVTX_POP()      (void)0
+#endif
+
+cudaError_t launch_fill(void* p, size_t bytes, unsigned mask, uint64_t salt, cudaStream_t stream);
+cudaError_t launch_verify(void const* p,
+                          size_t bytes,
+                          unsigned mask,
+                          uint64_t salt,
+                          unsigned long long* mismatches,
+                          cudaStream_t stream);
+cudaError_t launch_or(void* dst, void const* src, size_t bytes, cudaStream_t stream);
+
+#define CK(call)                                                                              \
+  do {                                                                                        \
+    cudaError_t const ck_e = (call);                                                          \
+    if (ck_e != cudaSuccess) {                                                                \
+      std::fprintf(stderr, "CUDA error %s (%d) at %s:%d: %s\n", cudaGetErrorName(ck_e),       \
+                   static_cast<int>(ck_e), __FILE__, __LINE__, #call);                        \
+      std::fflush(stdout);                                                                    \
+      std::exit(2);                                                                           \
+    }                                                                                         \
+  } while (0)
+
+namespace {
+
+constexpr size_t MiB = 1ull << 20;
+using ev_t           = cudaEvent_t;
+
+enum stream_id { TX = 0, RX, KS, RX2, KS2, TX2, AUX, AUX2, NST };
+enum buffer_id { PART = 0, SCR, BG, RPART, RSCR, NBUF };
+
+struct device {
+  cudaStream_t st[NST]{};
+  cudaMemPool_t pool{};
+  std::vector<ev_t> events;
+  size_t next_event{0};
+  void* buf[NBUF]{};
+  unsigned long long* counter{};
+};
+
+int G = 4;
+size_t BMAX = 1434 * MiB;  // largest payload
+size_t HSZ  = 0;           // size of every device / host buffer (>= BMAX, room for chunk slots)
+device dv[4];
+char* hb[6]{};         // cudaHostAlloc(Portable) buffers
+char* hreg  = nullptr; // mmap + populate + cudaHostRegister (the engine's host-pool recipe), 4K pages
+char* hthp  = nullptr; // same with transparent huge pages
+char* hpage = nullptr; // pageable
+bool can[4][4]{};
+bool g_nopeer = false;
+bool g_probe  = false;
+int g_reps    = 5;
+uint64_t g_salt = 1;
+size_t g_bgleg   = 0;  // bytes per leg of the background copies (contention tests)
+cudaError_t g_err = cudaSuccess;
+
+#ifdef USE_RMM
+std::vector<std::unique_ptr<rmm::mr::cuda_async_memory_resource>> g_mrs;
+#endif
+
+double now_ms()
+{
+  return std::chrono::duration<double, std::milli>(
+           std::chrono::steady_clock::now().time_since_epoch())
+    .count();
+}
+
+bool soft(cudaError_t e)
+{
+  if (e != cudaSuccess) {
+    if (g_err == cudaSuccess) { g_err = e; }
+    (void)cudaGetLastError();
+    return false;
+  }
+  return true;
+}
+
+char* P(int g) { return static_cast<char*>(dv[g].buf[PART]); }
+char* S(int g) { return static_cast<char*>(dv[g].buf[SCR]); }
+char* B_(int g, int b) { return static_cast<char*>(dv[g].buf[b]); }
+
+ev_t new_event(int g)
+{
+  auto& d = dv[g];
+  if (d.next_event == d.events.size()) {
+    for (int i = 0; i < 1024; ++i) {
+      ev_t e{};
+      CK(cudaEventCreateWithFlags(&e, cudaEventDisableTiming));
+      d.events.push_back(e);
+    }
+  }
+  return d.events[d.next_event++];
+}
+
+struct deps {
+  ev_t e[12]{};
+  int n{0};
+  deps() = default;
+  deps(std::initializer_list<ev_t> list)
+  {
+    for (auto x : list) { add(x); }
+  }
+  void add(ev_t x)
+  {
+    if (x != nullptr) { e[n++] = x; }
+  }
+  void add(deps const& o)
+  {
+    for (int i = 0; i < o.n; ++i) { add(o.e[i]); }
+  }
+};
+
+void wait_deps(cudaStream_t s, deps const& d)
+{
+  for (int i = 0; i < d.n; ++i) { CK(cudaStreamWaitEvent(s, d.e[i], 0)); }
+}
+
+ev_t record(int g, cudaStream_t s)
+{
+  ev_t const e = new_event(g);
+  CK(cudaEventRecord(e, s));
+  return e;
+}
+
+// Every op: runs on a stream of the named device, after `d`, and returns its completion event.
+ev_t op_d2h(int g, int si, void* host, void const* dev, size_t n, deps const& d = {})
+{
+  CK(cudaSetDevice(g));
+  auto const s = dv[g].st[si];
+  wait_deps(s, d);
+  CK(cudaMemcpyAsync(host, dev, n, cudaMemcpyDeviceToHost, s));
+  return record(g, s);
+}
+
+ev_t op_h2d(int g, int si, void* dev, void const* host, size_t n, deps const& d = {})
+{
+  CK(cudaSetDevice(g));
+  auto const s = dv[g].st[si];
+  wait_deps(s, d);
+  CK(cudaMemcpyAsync(dev, host, n, cudaMemcpyHostToDevice, s));
+  return record(g, s);
+}
+
+// cudaMemcpyPeerAsync on a stream of the destination device.
+ev_t op_p2p(int dst, int si, void* dp, int src, void const* sp, size_t n, deps const& d = {})
+{
+  CK(cudaSetDevice(dst));
+  auto const s = dv[dst].st[si];
+  wait_deps(s, d);
+  if (!soft(cudaMemcpyPeerAsync(dp, dst, sp, src, n, s))) { return nullptr; }
+  return record(dst, s);
+}
+
+ev_t op_or(int g, int si, void* dp, void const* sp, size_t n, deps const& d = {})
+{
+  CK(cudaSetDevice(g));
+  auto const s = dv[g].st[si];
+  wait_deps(s, d);
+  CK(launch_or(dp, sp, n, s));
+  return record(g, s);
+}
+
+enum transport { PEERAPI, BOUNCE };
+
+// One edge src -> dst. BOUNCE: D2H into `hslot` on the source's stream, then H2D on the
+// destination's stream; `*hfree` carries the slot's last reader so the slot can be reused.
+ev_t xfer(transport m,
+          int dst,
+          int dsi,
+          void* dp,
+          int src,
+          int ssi,
+          void const* sp,
+          size_t n,
+          deps const& src_deps,
+          deps const& dst_deps,
+          char* hslot,
+          ev_t* hfree)
+{
+  if (m == PEERAPI) {
+    deps d = src_deps;
+    d.add(dst_deps);
+    return op_p2p(dst, dsi, dp, src, sp, n, d);
+  }
+  deps d1 = src_deps;
+  d1.add(*hfree);
+  ev_t const e1 = op_d2h(src, ssi, hslot, sp, n, d1);
+  deps d2       = dst_deps;
+  d2.add(e1);
+  ev_t const e2 = op_h2d(dst, dsi, dp, hslot, n, d2);
+  *hfree        = e2;
+  return e2;
+}
+
+void sync_stream(int g, int si)
+{
+  CK(cudaSetDevice(g));
+  CK(cudaStreamSynchronize(dv[g].st[si]));
+}
+
+void sync_streams()
+{
+  for (int g = 0; g < G; ++g) {
+    CK(cudaSetDevice(g));
+    // AUX2 belongs to the background-load threads of the contention test.
+    for (int i = 0; i < AUX2; ++i) { CK(cudaStreamSynchronize(dv[g].st[i])); }
+  }
+}
+
+void sync_all()
+{
+  for (int g = 0; g < G; ++g) {
+    CK(cudaSetDevice(g));
+    CK(cudaDeviceSynchronize());
+  }
+}
+
+void fill(int g, void* p, size_t n, unsigned mask, uint64_t salt)
+{
+  CK(cudaSetDevice(g));
+  CK(launch_fill(p, n, mask, salt, dv[g].st[KS]));
+}
+
+unsigned long long verify(int g, void const* p, size_t n, unsigned mask, uint64_t salt)
+{
+  CK(cudaSetDevice(g));
+  auto const s = dv[g].st[KS];
+  CK(cudaMemsetAsync(dv[g].counter, 0, sizeof(unsigned long long), s));
+  CK(launch_verify(p, n, mask, salt, dv[g].counter, s));
+  CK(cudaStreamSynchronize(s));
+  unsigned long long v = 0;
+  CK(cudaMemcpy(&v, dv[g].counter, sizeof(v), cudaMemcpyDeviceToHost));
+  return v;
+}
+
+struct result_t {
+  double med{0}, mn{0}, mx{0}, sub{0};
+  unsigned long long mism{0};
+  int reps{0};
+  cudaError_t err{cudaSuccess};
+};
+
+double median(std::vector<double> v)
+{
+  if (v.empty()) { return 0; }
+  std::sort(v.begin(), v.end());
+  size_t const n = v.size();
+  return (n % 2 != 0) ? v[n / 2] : 0.5 * (v[n / 2 - 1] + v[n / 2]);
+}
+
+// reps + 1 runs, the first is a warm-up. `run` returns the time until every call was submitted
+// (ms) or a negative number. `ver` runs after the warm-up and after the last rep.
+result_t measure(char const* name,
+             int reps,
+             std::function<void(int)> const& prep,
+             std::function<double()> const& run,
+             std::function<unsigned long long()> const& ver)
+{
+  result_t st;
+  std::vector<double> t, s;
+  for (int r = 0; r <= reps; ++r) {
+    for (int g = 0; g < G; ++g) { dv[g].next_event = 0; }
+    prep(r);
+    sync_all();
+    NVTX_PUSH(name);
+    double const t0  = now_ms();
+    double const sub = run();
+    double const el  = now_ms() - t0;
+    NVTX_POP();
+    if (g_err != cudaSuccess) {
+      st.err = g_err;
+      g_err  = cudaSuccess;
+      for (int g = 0; g < G; ++g) {
+        (void)cudaSetDevice(g);
+        (void)cudaDeviceSynchronize();
+        (void)cudaGetLastError();
+      }
+      return st;
+    }
+    if (r == 0 || r == reps) { st.mism += ver(); }
+    if (r > 0) {
+      t.push_back(el);
+      s.push_back(sub);
+    }
+  }
+  st.med  = median(t);
+  st.mn   = *std::min_element(t.begin(), t.end());
+  st.mx   = *std::max_element(t.begin(), t.end());
+  st.sub  = median(s);
+  st.reps = reps;
+  return st;
+}
+
+void report(char const* test, std::string const& name, size_t bytes, result_t const& st)
+{
+  if (st.err != cudaSuccess) {
+    std::printf("R|%s|%s|bytes=%zu|ERR=%s\n", test, name.c_str(), bytes, cudaGetErrorName(st.err));
+  } else {
+    double const gib = static_cast<double>(bytes) / static_cast<double>(1ull << 30);
+    std::printf(
+      "R|%s|%s|bytes=%zu|med_ms=%.3f|min_ms=%.3f|max_ms=%.3f|gibps=%.2f|ms_per_gib=%.2f|"
+      "submit_ms=%.3f|mism=%llu|reps=%d\n",
+      test, name.c_str(), bytes, st.med, st.mn, st.mx, gib / (st.med / 1000.0), st.med / gib,
+      st.sub, st.mism, st.reps);
+  }
+  std::fflush(stdout);
+}
+
+std::string mib(size_t n) { return std::to_string(n / MiB); }
+
+// ---- host copies the way the engine's staging does: 1 MiB blocks through the batch API ----
+void copy_host(cudaStream_t s, char* dev, char* host, size_t n, bool to_host, bool blocks)
+{
+  if (!blocks) {
+    if (to_host) {
+      CK(cudaMemcpyAsync(host, dev, n, cudaMemcpyDeviceToHost, s));
+    } else {
+      CK(cudaMemcpyAsync(dev, host, n, cudaMemcpyHostToDevice, s));
+    }
+    return;
+  }
+  static thread_local std::vector<void*> d;
+  static thread_local std::vector<void const*> sr;
+  static thread_local std::vector<size_t> sz;
+  d.clear();
+  sr.clear();
+  sz.clear();
+  for (size_t off = 0; off < n; off += MiB) {
+    size_t const m = std::min(MiB, n - off);
+    d.push_back(to_host ? host + off : dev + off);
+    sr.push_back(to_host ? dev + off : host + off);
+    sz.push_back(m);
+  }
+  if (d.size() == 1) {
+    CK(cudaMemcpyAsync(d[0], sr[0], sz[0], to_host ? cudaMemcpyDeviceToHost : cudaMemcpyHostToDevice,
+                       s));
+    return;
+  }
+  cudaMemcpyAttributes at{};
+  at.srcAccessOrder = cudaMemcpySrcAccessOrderStream;
+  at.flags          = cudaMemcpyFlagDefault;
+  size_t idx        = 0;
+  CK(cudaMemcpyBatchAsync(d.data(), sr.data(), sz.data(), d.size(), &at, &idx, 1, s));
+}
+
+// ---- host OR ----
+void host_or(char* out, char* const* in, int nin, size_t n, int nt)
+{
+  constexpr size_t blk = 1 << 16;
+  long const nblk      = static_cast<long>((n + blk - 1) / blk);
+  bool const aligned   = (reinterpret_cast<uintptr_t>(out) % 64) == 0;
+#pragma omp parallel for num_threads(nt) schedule(static)
+  for (long b = 0; b < nblk; ++b) {
+    size_t const lo = static_cast<size_t>(b) * blk;
+    size_t const hi = std::min(n, lo + blk);
+    size_t i        = lo;
+    for (; i + 64 <= hi; i += 64) {
+      __m512i v = _mm512_loadu_si512(in[0] + i);
+      for (int k = 1; k < nin; ++k) { v = _mm512_or_si512(v, _mm512_loadu_si512(in[k] + i)); }
+      if (aligned) {
+        _mm512_stream_si512(reinterpret_cast<__m512i*>(out + i), v);
+      } else {
+        _mm512_storeu_si512(out + i, v);
+      }
+    }
+    for (; i < hi; ++i) {
+      char v = in[0][i];
+      for (int k = 1; k < nin; ++k) { v = static_cast<char>(v | in[k][i]); }
+      out[i] = v;
+    }
+    _mm_sfence();
+  }
+}
+
+// =============================== setup ===============================
+
+char* map_host(size_t bytes, bool huge)
+{
+  size_t const align = 2 * MiB;
+  char* raw          = static_cast<char*>(
+    mmap(nullptr, bytes + align, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0));
+  if (raw == MAP_FAILED) {
+    std::perror("mmap");
+    std::exit(3);
+  }
+  char* p = reinterpret_cast<char*>((reinterpret_cast<uintptr_t>(raw) + align - 1) / align * align);
+  if (huge) { (void)madvise(p, bytes, MADV_HUGEPAGE); }
+#ifdef MADV_POPULATE_WRITE
+  if (madvise(p, bytes, MADV_POPULATE_WRITE) != 0) { std::memset(p, 1, bytes); }
+#else
+  std::memset(p, 1, bytes);
+#endif
+  return p;
+}
+
+void setup()
+{
+  int count = 0;
+  CK(cudaGetDeviceCount(&count));
+  G = std::min(4, count);
+#ifdef USE_RMM
+  int const with_rmm = 1;
+#else
+  int const with_rmm = 0;
+#endif
+  std::printf("I|devices=%d|cudart=%d|rmm=%d|nopeer=%d|probe=%d|bmax_mib=%zu|buf_mib=%zu\n", count,
+              CUDART_VERSION, with_rmm, g_nopeer ? 1 : 0, g_probe ? 1 : 0, BMAX / MiB, HSZ / MiB);
+  for (int g = 0; g < G; ++g) {
+    CK(cudaSetDevice(g));
+    CK(cudaFree(nullptr));
+    cudaDeviceProp prop{};
+    CK(cudaGetDeviceProperties(&prop, g));
+    std::printf("I|dev=%d|name=%s|pci=%04x:%02x:%02x|sm=%d.%d\n", g, prop.name, prop.pciDomainID,
+                prop.pciBusID, prop.pciDeviceID, prop.major, prop.minor);
+    for (auto& s : dv[g].st) { CK(cudaStreamCreateWithFlags(&s, cudaStreamNonBlocking)); }
+#ifdef USE_RMM
+    g_mrs.push_back(std::make_unique<rmm::mr::cuda_async_memory_resource>());
+    dv[g].pool = g_mrs.back()->pool_handle();
+#else
+    // Same properties as the pool owned by rmm::mr::cuda_async_memory_resource.
+    cudaMemPoolProps props{};
+    props.allocType     = cudaMemAllocationTypePinned;
+    props.handleTypes   = cudaMemHandleTypeNone;
+    props.location.type = cudaMemLocationTypeDevice;
+    props.location.id   = g;
+    CK(cudaMemPoolCreate(&dv[g].pool, &props));
+    uint64_t threshold = UINT64_MAX;
+    CK(cudaMemPoolSetAttribute(dv[g].pool, cudaMemPoolAttrReleaseThreshold, &threshold));
+#endif
+  }
+  for (int a = 0; a < G; ++a) {
+    for (int b = 0; b < G; ++b) {
+      if (a == b) { continue; }
+      int v = 0, rank = -1, access = -1, nvlink = -1;
+      CK(cudaDeviceCanAccessPeer(&v, a, b));
+      can[a][b] = v != 0;
+      (void)soft(cudaDeviceGetP2PAttribute(&rank, cudaDevP2PAttrPerformanceRank, a, b));
+      (void)soft(cudaDeviceGetP2PAttribute(&access, cudaDevP2PAttrAccessSupported, a, b));
+      (void)soft(cudaDeviceGetP2PAttribute(&nvlink, cudaDevP2PAttrNativeAtomicSupported, a, b));
+      g_err = cudaSuccess;
+      std::printf("I|peer|%d>%d|can_access=%d|perf_rank=%d|access_supported=%d|native_atomic=%d\n", a, b,
+                  v, rank, access, nvlink);
+    }
+  }
+  if (!g_nopeer) {
+    for (int a = 0; a < G; ++a) {
+      for (int b = 0; b < G; ++b) {
+        if (a == b || (!can[a][b] && !g_probe)) { continue; }
+        CK(cudaSetDevice(a));
+        cudaError_t const e1 = cudaDeviceEnablePeerAccess(b, 0);
+        (void)cudaGetLastError();
+        // Owner pool `a` grants device `b` access (what the engine's grant does).
+        cudaMemAccessDesc desc{};
+        desc.location.type   = cudaMemLocationTypeDevice;
+        desc.location.id     = b;
+        desc.flags           = cudaMemAccessFlagsProtReadWrite;
+        cudaError_t const e2 = cudaMemPoolSetAccess(dv[a].pool, &desc, 1);
+        (void)cudaGetLastError();
+        std::printf("I|grant|ctx=%d|peer=%d|can=%d|EnablePeerAccess=%s|MemPoolSetAccess=%s\n", a, b,
+                    can[a][b] ? 1 : 0, cudaGetErrorName(e1), cudaGetErrorName(e2));
+      }
+    }
+  }
+  for (int g = 0; g < G; ++g) {
+    CK(cudaSetDevice(g));
+    for (int b : {PART, SCR, BG}) {
+      CK(cudaMallocFromPoolAsync(&dv[g].buf[b], HSZ, dv[g].pool, dv[g].st[KS]));
+    }
+    CK(cudaStreamSynchronize(dv[g].st[KS]));
+    CK(cudaMalloc(&dv[g].buf[RPART], HSZ));
+    CK(cudaMalloc(&dv[g].buf[RSCR], HSZ));
+    void* c = nullptr;
+    CK(cudaMalloc(&c, sizeof(unsigned long long)));
+    dv[g].counter = static_cast<unsigned long long*>(c);
+    for (int b = 0; b < NBUF; ++b) { CK(launch_fill(dv[g].buf[b], HSZ, 1u << g, 7, dv[g].st[KS])); }
+    (void)new_event(g);
+    dv[g].next_event = 0;
+  }
+  sync_all();
+  CK(cudaSetDevice(0));
+  for (auto& h : hb) {
+    void* p = nullptr;
+    CK(cudaHostAlloc(&p, HSZ, cudaHostAllocPortable));
+    h = static_cast<char*>(p);
+    std::memset(h, 1, HSZ);
+  }
+  hreg = map_host(HSZ, false);
+  CK(cudaHostRegister(hreg, HSZ, cudaHostRegisterPortable | cudaHostRegisterMapped));
+  hthp = map_host(HSZ, true);
+  CK(cudaHostRegister(hthp, HSZ, cudaHostRegisterPortable | cudaHostRegisterMapped));
+  hpage = map_host(HSZ, false);
+  // Warm the OpenMP pool.
+#pragma omp parallel
+  {
+    volatile int x = omp_get_thread_num();
+    (void)x;
+  }
+  std::printf("I|setup_done|omp_max_threads=%d\n", omp_get_max_threads());
+  std::fflush(stdout);
+}
+
+// =============================== leg ===============================
+
+void test_leg(std::vector<size_t> const& sizes)
+{
+  auto const noprep = [](int) {};
+  auto const nover  = []() -> unsigned long long { return 0; };
+  for (int g = 0; g < G; ++g) {
+    for (size_t n : sizes) {
+      auto whole = [&](char const* nm, bool to_host, char* h, int buf) {
+        result_t st = measure(nm, g_reps, noprep, [&]() -> double {
+          CK(cudaSetDevice(g));
+          auto const s = dv[g].st[to_host ? TX : RX];
+          double const t0 = now_ms();
+          copy_host(s, B_(g, buf), h, n, to_host, false);
+          double const sub = now_ms() - t0;
+          CK(cudaStreamSynchronize(s));
+          return sub;
+        }, nover);
+        report("leg", "g" + std::to_string(g) + "|" + nm + "|n=" + mib(n), n, st);
+      };
+      whole("d2h|host=pinned|dev=pool", true, hb[0], PART);
+      whole("h2d|host=pinned|dev=pool", false, hb[0], SCR);
+      whole("d2h|host=pinned|dev=raw", true, hb[0], RPART);
+      whole("h2d|host=pinned|dev=raw", false, hb[0], RSCR);
+      whole("d2h|host=registered4k|dev=pool", true, hreg, PART);
+      whole("h2d|host=registered4k|dev=pool", false, hreg, SCR);
+      whole("d2h|host=registeredthp|dev=pool", true, hthp, PART);
+      whole("h2d|host=registeredthp|dev=pool", false, hthp, SCR);
+      whole("d2h|host=pageable|dev=pool", true, hpage, PART);
+      whole("h2d|host=pageable|dev=pool", false, hpage, SCR);
+      auto chunked = [&](char const* nm, bool to_host, size_t chunk, bool blocks) {
+        result_t st = measure(nm, g_reps, noprep, [&]() -> double {
+          CK(cudaSetDevice(g));
+          auto const s = dv[g].st[to_host ? TX : RX];
+          char* const h = blocks ? hreg : hb[0];
+          for (size_t off = 0; off < n; off += chunk) {
+            size_t const m = std::min(chunk, n - off);
+            copy_host(s, B_(g, to_host ? PART : SCR) + off, h, m, to_host, blocks);
+            CK(cudaStreamSynchronize(s));
+          }
+          return -1;
+        }, nover);
+        report("leg", "g" + std::to_string(g) + "|" + nm + "|n=" + mib(n), n, st);
+      };
+      if (n >= 8 * MiB) {
+        chunked("d2h_sync|chunk=8|blk=contig", true, 8 * MiB, false);
+        chunked("h2d_sync|chunk=8|blk=contig", false, 8 * MiB, false);
+        chunked("d2h_sync|chunk=8|blk=1m_batch", true, 8 * MiB, true);
+        chunked("h2d_sync|chunk=8|blk=1m_batch", false, 8 * MiB, true);
+        chunked("d2h_sync|chunk=2|blk=contig", true, 2 * MiB, false);
+        chunked("h2d_sync|chunk=2|blk=contig", false, 2 * MiB, false);
+      }
+    }
+  }
+}
+
+// =============================== pair ===============================
+
+double run_stage_pipe(int a, int b, size_t n, size_t chunk, int K, char* h)
+{
+  ev_t hfree[8]{};
+  double const t0 = now_ms();
+  size_t i        = 0;
+  for (size_t off = 0; off < n; off += chunk, ++i) {
+    size_t const m = std::min(chunk, n - off);
+    int const j    = static_cast<int>(i % static_cast<size_t>(K));
+    ev_t const e1  = op_d2h(a, TX, h + j * chunk, P(a) + off, m, {hfree[j]});
+    hfree[j]       = op_h2d(b, RX, S(b) + off, h + j * chunk, m, {e1});
+  }
+  double const sub = now_ms() - t0;
+  sync_stream(a, TX);
+  sync_stream(b, RX);
+  return sub;
+}
+
+void test_pair(std::vector<size_t> const& sizes, bool all_methods)
+{
+  for (int a = 0; a < G; ++a) {
+    for (int b = 0; b < G; ++b) {
+      if (a == b) { continue; }
+      bool const sec =
+        (a == 0 && b == 1) || (a == 0 && b == 2) || (a == 2 && b == 0) || (a == 1 && b == 3);
+      for (size_t n : sizes) {
+        uint64_t salt = 0;
+        int sbuf = PART, dbuf = SCR;
+        auto const prep = [&](int r) {
+          if (r == 0) {
+            salt = ++g_salt;
+            fill(a, B_(a, sbuf), n, 1u << a, salt);
+            fill(b, B_(b, dbuf), n, 0, salt);
+          }
+        };
+        auto const ver = [&]() -> unsigned long long {
+          return verify(b, B_(b, dbuf), n, 1u << a, salt);
+        };
+        std::string const pre = std::to_string(a) + ">" + std::to_string(b) + "|p2p=" +
+                                ((can[a][b] && !g_nopeer) ? "1" : "0") + "|n=" + mib(n) + "|";
+        auto go = [&](std::string const& nm, std::function<double()> const& fn) {
+          result_t st = measure(nm.c_str(), g_reps, prep, fn, ver);
+          report("pair", pre + nm, n, st);
+        };
+        auto peer = [&](bool on_src) -> double {
+          int const d = on_src ? a : b;
+          CK(cudaSetDevice(d));
+          auto const s    = dv[d].st[RX];
+          double const t0 = now_ms();
+          (void)soft(cudaMemcpyPeerAsync(B_(b, dbuf), b, B_(a, sbuf), a, n, s));
+          double const sub = now_ms() - t0;
+          (void)soft(cudaStreamSynchronize(s));
+          return sub;
+        };
+        go("peerasync|alloc=pool|stream=dst", [&] { return peer(false); });
+        sbuf = RPART;
+        dbuf = RSCR;
+        go("peerasync|alloc=raw|stream=dst", [&] { return peer(false); });
+        sbuf = PART;
+        dbuf = SCR;
+        go("memcpyasync_d2d|alloc=pool|stream=dst", [&]() -> double {
+          CK(cudaSetDevice(b));
+          auto const s    = dv[b].st[RX];
+          double const t0 = now_ms();
+          (void)soft(cudaMemcpyAsync(S(b), P(a), n, cudaMemcpyDeviceToDevice, s));
+          double const sub = now_ms() - t0;
+          (void)soft(cudaStreamSynchronize(s));
+          return sub;
+        });
+        if (sec || g_nopeer || g_probe) {
+          go("peerasync|alloc=pool|stream=src", [&] { return peer(true); });
+        }
+        if (!all_methods) { continue; }
+        auto stage_sync = [&](size_t chunk, bool blocks, char* h) -> double {
+          for (size_t off = 0; off < n; off += chunk) {
+            size_t const m = std::min(chunk, n - off);
+            CK(cudaSetDevice(a));
+            copy_host(dv[a].st[TX], P(a) + off, h, m, true, blocks);
+            CK(cudaStreamSynchronize(dv[a].st[TX]));
+            CK(cudaSetDevice(b));
+            copy_host(dv[b].st[RX], S(b) + off, h, m, false, blocks);
+            CK(cudaStreamSynchronize(dv[b].st[RX]));
+          }
+          return -1;
+        };
+        go("stage_sync|chunk=8|blk=1m_batch", [&] { return stage_sync(8 * MiB, true, hreg); });
+        go("stage_sync|chunk=8|blk=contig", [&] { return stage_sync(8 * MiB, false, hb[0]); });
+        go("stage_sync|chunk=2|blk=contig", [&] { return stage_sync(2 * MiB, false, hb[0]); });
+        go("stage_pipe|chunk=8|slots=2|host=pinned",
+           [&] { return run_stage_pipe(a, b, n, 8 * MiB, 2, hb[0]); });
+        go("stage_pipe|chunk=32|slots=2|host=pinned",
+           [&] { return run_stage_pipe(a, b, n, 32 * MiB, 2, hb[0]); });
+        go("stage_pipe|chunk=whole|slots=1|host=pinned",
+           [&] { return run_stage_pipe(a, b, n, n, 1, hb[0]); });
+        if (!sec) { continue; }
+        go("stage_pipe|chunk=2|slots=2|host=pinned",
+           [&] { return run_stage_pipe(a, b, n, 2 * MiB, 2, hb[0]); });
+        go("stage_pipe|chunk=16|slots=2|host=pinned",
+           [&] { return run_stage_pipe(a, b, n, 16 * MiB, 2, hb[0]); });
+        go("stage_pipe|chunk=64|slots=2|host=pinned",
+           [&] { return run_stage_pipe(a, b, n, 64 * MiB, 2, hb[0]); });
+        go("stage_pipe|chunk=8|slots=4|host=pinned",
+           [&] { return run_stage_pipe(a, b, n, 8 * MiB, 4, hb[0]); });
+        go("stage_pipe|chunk=32|slots=4|host=pinned",
+           [&] { return run_stage_pipe(a, b, n, 32 * MiB, 4, hb[0]); });
+        go("stage_pipe|chunk=32|slots=2|host=registered4k",
+           [&] { return run_stage_pipe(a, b, n, 32 * MiB, 2, hreg); });
+        go("stage_pipe|chunk=32|slots=2|host=registeredthp",
+           [&] { return run_stage_pipe(a, b, n, 32 * MiB, 2, hthp); });
+        go("stage_pipe|chunk=whole|slots=1|host=registered4k",
+           [&] { return run_stage_pipe(a, b, n, n, 1, hreg); });
+        auto pageable = [&](size_t chunk) -> double {
+          for (size_t off = 0; off < n; off += chunk) {
+            size_t const m = std::min(chunk, n - off);
+            CK(cudaSetDevice(a));
+            CK(cudaMemcpyAsync(hpage, P(a) + off, m, cudaMemcpyDeviceToHost, dv[a].st[TX]));
+            CK(cudaStreamSynchronize(dv[a].st[TX]));
+            CK(cudaSetDevice(b));
+            CK(cudaMemcpyAsync(S(b) + off, hpage, m, cudaMemcpyHostToDevice, dv[b].st[RX]));
+            CK(cudaStreamSynchronize(dv[b].st[RX]));
+          }
+          return -1;
+        };
+        go("stage_sync|chunk=whole|host=pageable", [&] { return pageable(n); });
+        go("stage_sync|chunk=8|host=pageable", [&] { return pageable(8 * MiB); });
+      }
+    }
+  }
+}
