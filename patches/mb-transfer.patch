+// =============================== concurrency ===============================
+
+struct leg {
+  char kind;  // D: d2h a -> hb[h]; H: h2d hb[h] -> b; P: peer API a -> b; B: pipelined bounce a -> b
+  int a, b, h;
+  int sbuf, dbuf;
+};
+
+void run_legs(char const* test, std::string const& name, std::vector<leg> const& legs, size_t n)
+{
+  int const L = static_cast<int>(legs.size());
+  std::vector<std::vector<double>> tl(static_cast<size_t>(L));
+  std::vector<double> tot;
+  for (int r = 0; r <= g_reps; ++r) {
+    for (int g = 0; g < G; ++g) { dv[g].next_event = 0; }
+    sync_all();
+    int sc[4] = {0, 0, 0, 0};
+    std::vector<ev_t> ev(static_cast<size_t>(L));
+    std::vector<int> evdev(static_cast<size_t>(L));
+    double const t0 = now_ms();
+    for (int l = 0; l < L; ++l) {
+      leg const& x = legs[static_cast<size_t>(l)];
+      switch (x.kind) {
+        case 'D':
+          ev[l]    = op_d2h(x.a, sc[x.a]++, hb[x.h], B_(x.a, x.sbuf), n);
+          evdev[l] = x.a;
+          break;
+        case 'H':
+          ev[l]    = op_h2d(x.b, sc[x.b]++, B_(x.b, x.dbuf), hb[x.h], n);
+          evdev[l] = x.b;
+          break;
+        case 'P':
+          ev[l]    = op_p2p(x.b, sc[x.b]++, B_(x.b, x.dbuf), x.a, B_(x.a, x.sbuf), n);
+          evdev[l] = x.b;
+          break;
+        default: {
+          int const sa = sc[x.a]++, sb = sc[x.b]++;
+          size_t const chunk = 32 * MiB;
+          ev_t hfree[2]{};
+          ev_t last = nullptr;
+          size_t i  = 0;
+          for (size_t off = 0; off < n; off += chunk, ++i) {
+            size_t const m = std::min(chunk, n - off);
+            int const j    = static_cast<int>(i % 2);
+            ev_t const e1 =
+              op_d2h(x.a, sa, hb[x.h] + j * chunk, B_(x.a, x.sbuf) + off, m, {hfree[j]});
+            hfree[j] = op_h2d(x.b, sb, B_(x.b, x.dbuf) + off, hb[x.h] + j * chunk, m, {e1});
+            last     = hfree[j];
+          }
+          ev[l]    = last;
+          evdev[l] = x.b;
+        }
+      }
+    }
+    if (g_err != cudaSuccess) {
+      std::printf("R|%s|%s|bytes=%zu|ERR=%s\n", test, name.c_str(), n, cudaGetErrorName(g_err));
+      g_err = cudaSuccess;
+      sync_all();
+      return;
+    }
+    std::vector<double> te(static_cast<size_t>(L), -1.0);
+    int done = 0;
+    while (done < L) {
+      for (int l = 0; l < L; ++l) {
+        if (te[l] >= 0) { continue; }
+        CK(cudaSetDevice(evdev[l]));
+        cudaError_t const q = cudaEventQuery(ev[l]);
+        if (q == cudaSuccess) {
+          te[l] = now_ms() - t0;
+          ++done;
+        } else if (q != cudaErrorNotReady) {
+          CK(q);
+        }
+      }
+    }
+    if (r > 0) {
+      for (int l = 0; l < L; ++l) { tl[l].push_back(te[l]); }
+      tot.push_back(*std::max_element(te.begin(), te.end()));
+    }
+  }
+  double const gib = static_cast<double>(n) / static_cast<double>(1ull << 30);
+  double const med = median(tot);
+  std::string per;
+  for (int l = 0; l < L; ++l) {
+    leg const& x = legs[static_cast<size_t>(l)];
+    char tmp[64];
+    char lab[16];
+    if (x.kind == 'D') {
+      std::snprintf(lab, sizeof lab, "D%d", x.a);
+    } else if (x.kind == 'H') {
+      std::snprintf(lab, sizeof lab, "H%d", x.b);
+    } else {
+      std::snprintf(lab, sizeof lab, "%c%d%d", x.kind, x.a, x.b);
+    }
+    std::snprintf(tmp, sizeof tmp, "%s%s=%.1f", l != 0 ? "," : "", lab,
+                  gib / (median(tl[l]) / 1000.0));
+    per += tmp;
+  }
+  std::printf("R|%s|%s|bytes=%zu|legs=%d|med_ms=%.3f|min_ms=%.3f|max_ms=%.3f|agg_gibps=%.2f|"
+              "leg_gibps=%s|reps=%d\n",
+              test, name.c_str(), n, L, med, *std::min_element(tot.begin(), tot.end()),
+              *std::max_element(tot.begin(), tot.end()), gib * L / (med / 1000.0), per.c_str(),
+              g_reps);
+  std::fflush(stdout);
+}
+
+leg D(int a, int h) { return {'D', a, -1, h, PART, SCR}; }
+leg H(int b, int h) { return {'H', -1, b, h, PART, SCR}; }
