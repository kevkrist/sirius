+// =============================== fan-out ===============================
+
+void test_fan(std::vector<size_t> const& sizes)
+{
+  for (size_t n : sizes) {
+    uint64_t salt   = 0;
+    auto const prep = [&](int) {
+      salt = ++g_salt;
+      fill(0, P(0), n, 1u, salt);
+      for (int t = 1; t < G; ++t) { fill(t, S(t), n, 0, salt); }
+    };
+    auto const ver = [&]() -> unsigned long long {
+      unsigned long long m = 0;
+      for (int t = 1; t < G; ++t) { m += verify(t, S(t), n, 1u, salt); }
+      return m;
+    };
+    auto go = [&](std::string const& nm, std::function<double()> const& fn) {
+      result_t st = measure(nm.c_str(), g_reps, prep, fn, ver);
+      report("fan", "n=" + mib(n) + "|" + nm, n, st);
+    };
+    // Today's replica copy (src/cuda/device_transfer.cpp host path): per target, whole payload
+    // D2H in 1 MiB blocks, sync, H2D, sync.
+    go("today_serial_per_target", [&]() -> double {
+      for (int t = 1; t < G; ++t) {
+        CK(cudaSetDevice(0));
+        copy_host(dv[0].st[KS], P(0), hreg, n, true, true);
+        CK(cudaStreamSynchronize(dv[0].st[KS]));
+        CK(cudaSetDevice(t));
+        copy_host(dv[t].st[KS], S(t), hreg, n, false, true);
+        CK(cudaStreamSynchronize(dv[t].st[KS]));
+      }
+      return -1;
+    });
+    // mode 0: staged once, three uploads; 1: P2P to the partner + staged once for the other pair;
+    // 2: P2P to the partner, staged once to GPU 2, relay 2 -> 3 by P2P.
+    auto fan = [&](size_t chunk, int K, int mode) -> double {
+      ev_t hf[4][3]{};
+      double const t0 = now_ms();
+      size_t i        = 0;
+      for (size_t off = 0; off < n; off += chunk, ++i) {
+        size_t const m = std::min(chunk, n - off);
+        int const j    = static_cast<int>(i % static_cast<size_t>(K));
+        char* const hs = hb[0] + j * chunk;
+        ev_t const e1  = op_d2h(0, TX, hs, P(0) + off, m, {hf[j][0], hf[j][1], hf[j][2]});
+        if (mode == 0) {
+          hf[j][0] = op_h2d(1, RX, S(1) + off, hs, m, {e1});
+        } else {
+          op_p2p(1, RX, S(1) + off, 0, P(0) + off, m);
+        }
+        hf[j][1] = op_h2d(2, RX, S(2) + off, hs, m, {e1});
+        if (mode == 2) {
+          op_p2p(3, RX, S(3) + off, 2, S(2) + off, m, {hf[j][1]});
+        } else {
+          hf[j][2] = op_h2d(3, RX, S(3) + off, hs, m, {e1});
+        }
+      }
+      double const sub = now_ms() - t0;
+      sync_streams();
+      return sub;
+    };
+    go("staged_once|chunk=whole", [&] { return fan(n, 1, 0); });
+    go("staged_once|chunk=32", [&] { return fan(32 * MiB, 2, 0); });
+    go("p2p_partner+staged_once|chunk=whole", [&] { return fan(n, 1, 1); });
+    go("p2p_partner+staged_once|chunk=32", [&] { return fan(32 * MiB, 2, 1); });
+    go("p2p_partner+staged_one+p2p_relay|chunk=32", [&] { return fan(32 * MiB, 2, 2); });
+    go("peerapi_all_targets|chunk=whole", [&]() -> double {
+      double const t0 = now_ms();
+      for (int t = 1; t < G; ++t) { op_p2p(t, RX, S(t), 0, P(0), n); }
+      double const sub = now_ms() - t0;
+      sync_streams();
+      return sub;
+    });
+  }
+}
