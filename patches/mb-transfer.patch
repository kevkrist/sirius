diff --git a/bench/transfer/build.sh b/bench/transfer/build.sh
new file mode 100755
index 00000000..60998984
--- /dev/null
+++ b/bench/transfer/build.sh
@@ -0,0 +1,32 @@
+#!/bin/bash
+# Builds the standalone transfer microbenchmark with the toolchain of the reference pixi env
+# (read-only use of $R/repo/.pixi). Run under: flock $R/machine.lock bench/transfer/build.sh
+R=${R:-/opt/dlami/nvme/dfperf}
+E=$R/repo/.pixi/envs/default
+SRC=$(cd "$(dirname "$0")" && pwd)
+OUT=${OUT:-$R/runs/mb_xfer/bin}
+export PATH=$E/bin:$PATH TMPDIR=$R/tmp
+mkdir -p "$OUT" "$TMPDIR"
+CXX=$E/bin/x86_64-conda-linux-gnu-c++
+CUDA_INC=$E/targets/x86_64-linux/include
+DEFS="-DCCCL_DISABLE_PDL -DCCCL_IGNORE_DEPRECATED_STREAM_REF_HEADER -DLIBCUDACXX_ENABLE_EXPERIMENTAL_MEMORY_RESOURCE -DFMT_SHARED -DSPDLOG_COMPILED_LIB -DSPDLOG_FMT_EXTERNAL -DSPDLOG_SHARED_LIB"
+INC="-I$E/include/rapids -isystem $E/include -I$CUDA_INC -isystem $CUDA_INC/cccl"
+set -x
+$E/bin/nvcc -ccbin $CXX -O3 -std=c++20 \
+  "--generate-code=arch=compute_90a,code=[sm_90a]" "--generate-code=arch=compute_100f,code=[sm_100f]" \
+  "--generate-code=arch=compute_120f,code=[sm_120f]" \
+  -I$CUDA_INC -c $SRC/xfer_kernels.cu -o $OUT/xfer_kernels.o || exit 1
+build_main() {
+  $CXX $1 $DEFS $INC -O3 -DNDEBUG -std=gnu++20 -fopenmp -mavx512f -mavx512bw -Wall -Wno-unknown-pragmas \
+    -c $SRC/xfer_bench.cpp -o $OUT/xfer_bench.o &&
+  $CXX $OUT/xfer_bench.o $OUT/xfer_kernels.o -o $OUT/xfer_bench -fopenmp \
+    -L$E/lib -L$E/targets/x86_64-linux/lib $2 -lcudart -ldl -lpthread \
+    -Wl,-rpath,$E/lib -Wl,-rpath,$E/targets/x86_64-linux/lib
+}
+if build_main -DUSE_RMM "-lrmm -lrapids_logger"; then
+  echo "BUILD_OK rmm=1"
+elif build_main "" ""; then
+  echo "BUILD_OK rmm=0 (RMM build failed; pool created with the same properties through raw CUDA)"
+else
+  echo "BUILD_FAILED"; exit 1
+fi
diff --git a/bench/transfer/run_all.sh b/bench/transfer/run_all.sh
new file mode 100755
index 00000000..b236204b
--- /dev/null
+++ b/bench/transfer/run_all.sh
@@ -0,0 +1,35 @@
+#!/bin/bash
+# One locked pass: build, smoke, main run, no-peer run, probe run, nsys capture.
+R=/opt/dlami/nvme/dfperf; M=$R/runs/mb_xfer; B=$M/bin/xfer_bench
+export TMPDIR=$R/tmp
+cd $M
+PHASES=${PHASES:-build,smoke,main,nopeer,probe,nsys}
+has() { [[ ",$PHASES," == *",$1,"* ]] && [ ! -f out/.ok_$1 ]; }
+ok() { touch out/.ok_$1; }
+if has build; then
+  $R/wt-mb-xfer/bench/transfer/build.sh > out/build.log 2>&1 || { echo "build failed"; grep -E 'error|Error' out/build.log | head -40; exit 10; }
+  tail -1 out/build.log; ok build
+fi
+if has smoke; then
+  timeout 600 $B tests=leg,pair,fan,hostor,conc,df,cont sizes=8 dfsizes=16 fansizes=1,8 bmax=64 reps=1 > out/smoke.log 2> out/smoke.err
+  rc=$?; echo "smoke rc=$rc lines=$(wc -l < out/smoke.log)"
+  [ $rc -ne 0 ] && { tail -5 out/smoke.err; tail -3 out/smoke.log; exit 11; }
+  bad=$(grep -E '^R\|(fan|df|cont)\|' out/smoke.log | grep -v -E 'peerapi|ERR=' | grep 'mism=' | grep -c -v 'mism=0|')
+  echo "smoke mismatching engineered schedules: $bad"
+  [ "$bad" -ne 0 ] && { grep -E '^R\|(fan|df|cont)\|' out/smoke.log | grep -v -E 'peerapi|ERR=' | grep 'mism=' | grep -v 'mism=0|' | cut -c1-200 | head -20; exit 12; }
+  ok smoke
+fi
+if has main; then
+  /usr/bin/time -v -o out/main.time timeout 2400 $B reps=${REPS:-5} ${MAINARGS:-} > out/${MAINLOG:-main}.log 2> out/main.err; rc=$?; echo "main rc=$rc lines=$(wc -l < out/${MAINLOG:-main}.log)"; [ $rc -eq 0 ] && ok main
+fi
+if has nopeer; then
+  timeout 900 $B nopeer=1 tests=pair pairmethods=peer reps=5 > out/nopeer.log 2> out/nopeer.err; rc=$?; echo "nopeer rc=$rc"; [ $rc -eq 0 ] && ok nopeer
+fi
+if has probe; then
+  timeout 900 $B probe=1 tests=pair pairmethods=peer sizes=64,1434 reps=3 > out/probe.log 2> out/probe.err; rc=$?; echo "probe rc=$rc"; [ $rc -eq 0 ] && ok probe
+fi
+if has nsys; then
+  mkdir -p nsys
+  timeout 900 nsys profile --trace=cuda,nvtx --sample=none --cudabacktrace=none --cpuctxsw=none --force-overwrite=true --export=sqlite \
+    -o $M/nsys/df281 $B tests=df dfsizes=281 reps=2 bmax=512 > out/nsys.log 2> out/nsys.err; rc=$?; echo "nsys rc=$rc"; [ $rc -eq 0 ] && ok nsys
+fi
