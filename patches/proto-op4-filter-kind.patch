+
+struct key_batch {
+  rmm::device_buffer data;
+  rmm::device_buffer mask;
+  cudf::type_id type;
+  cudf::size_type rows       = 0;
+  cudf::size_type null_count = 0;
+  bool nulls;
+
+  cudf::column_view view() const
+  {
+    return cudf::column_view{cudf::data_type{type},
+                             rows,
+                             data.data(),
+                             nulls ? static_cast<cudf::bitmask_type const*>(mask.data()) : nullptr,
+                             null_count};
+  }
+};
+
+template <class Key>
+void fill_batch(key_batch& batch, std::uint64_t base, cudf::size_type rows, key_spec spec, rmm::cuda_stream_view s)
+{
+  batch.rows = rows;
+  generate_keys(static_cast<Key*>(batch.data.data()), base, rows, spec, s);
+  if (batch.nulls) {
+    generate_validity(static_cast<cudf::bitmask_type*>(batch.mask.data()), rows, base * 31 + 7, s);
+    batch.null_count =
+      cudf::null_count(static_cast<cudf::bitmask_type const*>(batch.mask.data()), 0, rows, s);
+  }
+  s.synchronize();
+}
+
+template <class Key>
+int run_insert(arguments const& args)
+{
+  auto const array_bytes = static_cast<std::size_t>(args.num("array_mib", 300) * mib);
+  auto const bpk         = static_cast<std::size_t>(args.num("bpk", 16));
+  auto const batch_rows  = static_cast<std::int64_t>(args.num("batch", 16e6));
+  auto const dup         = static_cast<std::uint64_t>(args.num("dup", 1));
+  auto const nulls       = args.num("nulls", 0) != 0;
+  auto const variant     = args.str("variant", "prod");
+  auto const mode        = args.str("mode", "alone");  // alone | hp_only | hp_same | hp_second
+  auto const payload     = static_cast<int>(args.num("payload", 3));
+  auto const parts       = static_cast<int>(args.num("parts", 32));
+  auto const max_batches = static_cast<std::int64_t>(args.num("max_batches", 1e9));
+  auto const label       = args.str("label", "");
+  key_spec spec{args.str("order", "random") == "random", 0};
+
+  auto const blocks     = array_bytes / 32;
+  auto const total_rows = static_cast<std::uint64_t>(array_bytes) * 8 / bpk;
+  if (dup > 1) { spec.distinct = std::max<std::uint64_t>(total_rows / dup, 1); }
+  // At least `min_batches` batches: a small array is refilled with the same keys.
+  auto const min_batches = static_cast<std::int64_t>(args.num("min_batches", 6));
+  auto const batches     = std::min<std::int64_t>(
+    max_batches,
+    std::max<std::int64_t>(min_batches,
+                           static_cast<std::int64_t>((total_rows + batch_rows - 1) / batch_rows)));
+
+  environment env{static_cast<std::size_t>(args.num("gpu_gib", 80)) << 30};
+  rmm::cuda_set_device_raii guard{rmm::cuda_device_id{0}};
+  rmm::cuda_stream_view const task{env.task.value()};
+  rmm::cuda_stream_view const second{env.second.value()};
+  auto const type = sizeof(Key) == 8 ? cudf::type_id::INT64 : cudf::type_id::INT32;
+
+  key_batch batch{rmm::device_buffer{static_cast<std::size_t>(batch_rows) * sizeof(Key), task, env.raw},
+                  rmm::device_buffer{cudf::bitmask_allocation_size_bytes(batch_rows), task, env.raw},
+                  type,
+                  0,
+                  0,
+                  nulls};
+  bool const with_hp = mode != "alone";
+  std::vector<rmm::device_buffer> payload_cols;
+  if (with_hp) {
+    for (int c = 0; c < payload; ++c) {
+      payload_cols.emplace_back(static_cast<std::size_t>(batch_rows) * 8, task, env.raw);
+      check(cudaMemsetAsync(payload_cols.back().data(), c + 1, payload_cols.back().size(), task.value()),
+            "memset payload");
+    }
+  }
+
+  // Target array.
+  auto const t_create = clk::now();
+  std::optional<builder> accumulated;
+  rmm::device_buffer raw_bits;
+  bool const prod = variant == "prod" || variant == "sorted";
+  if (mode != "hp_only") {
+    if (prod) {
+      accumulated = builder::try_create({{0, cudf::data_type{type}, blocks}}, env.spaces);
+      if (!accumulated) { throw std::runtime_error("lease refused"); }
+    } else {
+      raw_bits = rmm::device_buffer{array_bytes, task, env.raw};
+      check(cudaMemsetAsync(raw_bits.data(), 0, array_bytes, task.value()), "memset");
+    }
+  }
+  check(cudaDeviceSynchronize(), "sync create");
+  auto const create_ms = ms_since(t_create);
+
+  rmm::device_uvector<std::uint64_t> pairs{0, task, env.raw};
+  if (variant == "sortpairs" || variant == "pairs" || variant == "sorted") {
+    pairs.resize(static_cast<std::size_t>(batch_rows), task);
+  }
+  auto const mr = env.gpu().get_default_allocator();
+  auto* const words = static_cast<unsigned long long*>(raw_bits.data());
+
+  std::vector<double> insert_ms;
+  std::vector<double> prep_ms;
+  std::vector<double> batch_row_counts;
+  std::uint64_t rows_done = 0;
+  std::uint64_t cursor    = 0;
+  for (std::int64_t b = 0; b < batches; ++b) {
+    if (cursor >= total_rows) { cursor = 0; }
+    auto const rows = static_cast<cudf::size_type>(
+      std::min<std::uint64_t>(static_cast<std::uint64_t>(batch_rows), total_rows - cursor));
+    fill_batch<Key>(batch, cursor, rows, spec, task);
+    cursor += static_cast<std::uint64_t>(rows);
+    batch_row_counts.push_back(rows);
+    auto const keys      = batch.view();
+    auto const* key_data = static_cast<Key const*>(batch.data.data());
+    auto const* mask     = nulls ? static_cast<std::uint32_t const*>(batch.mask.data()) : nullptr;
+    auto const grid      = static_cast<unsigned>((rows + 255) / 256);
+
+    // Untimed or separately timed pre-pass.
+    if (variant == "sorted") {
+      // Upper bound on locality: keys pre-sorted by block index (pre-pass timed in prep_ms).
+      auto const t0 = clk::now();
+      compute_pairs(key_data, rows, blocks, pairs.data(), task);
+      thrust::sort_by_key(rmm::exec_policy_nosync(task),
+                          pairs.begin(),
+                          pairs.begin() + rows,
+                          static_cast<Key*>(batch.data.data()));
+      task.synchronize();
+      prep_ms.push_back(ms_since(t0));
+    } else if (variant == "sortpairs") {
+      auto const t0 = clk::now();
+      compute_pairs(key_data, rows, blocks, pairs.data(), task);
+      thrust::sort(rmm::exec_policy_nosync(task), pairs.begin(), pairs.begin() + rows);
+      task.synchronize();
+      prep_ms.push_back(ms_since(t0));
+    } else if (variant == "pairs") {
+      auto const t0 = clk::now();
+      compute_pairs(key_data, rows, blocks, pairs.data(), task);
+      task.synchronize();
+      prep_ms.push_back(ms_since(t0));
+    }
+
+    std::vector<cudf::column_view> columns{keys};
+    for (auto const& col : payload_cols) {
+      columns.emplace_back(cudf::data_type{cudf::type_id::INT64}, rows, col.data(), nullptr, 0);
+    }
+    cudf::table_view const table{columns};
+    std::unique_ptr<cudf::table> scattered;
+
+    auto const insert = [&](rmm::cuda_stream_view s) {
+      ::cuda::stream_ref const sref{s.value()};
+      if (prod) {
+        if (!accumulated->enqueue_add(cudf::table_view{{keys}}, rmm::cuda_device_id{0}, sref)) {
+          throw std::runtime_error("no partial");
+        }
+      } else if (variant == "cuco_addif") {
+        make_ref<ref_prod<Key>>(raw_bits.data(), blocks)
+          .add_if_async(key_data,
+                        key_data + rows,
+                        thrust::counting_iterator<cudf::size_type>{0},
+                        op::detail::probe_validity_of(keys),
+                        sref);
+      } else if (variant == "cuco_add") {
+        make_ref<ref_prod<Key>>(raw_bits.data(), blocks).add_async(key_data, key_data + rows, sref);
+      } else if (variant == "cuco_cond") {
+        make_ref<ref_cond<Key>>(raw_bits.data(), blocks)
+          .add_if_async(key_data,
+                        key_data + rows,
+                        thrust::counting_iterator<cudf::size_type>{0},
+                        op::detail::probe_validity_of(keys),
+                        sref);
+      } else if (variant == "cuco_v8") {
+        make_ref<ref_v8<Key>>(raw_bits.data(), blocks)
+          .add_if_async(key_data,
+                        key_data + rows,
+                        thrust::counting_iterator<cudf::size_type>{0},
+                        op::detail::probe_validity_of(keys),
+                        sref);
+      } else if (variant == "cuco_v8c") {
+        make_ref<ref_v8c<Key>>(raw_bits.data(), blocks)
+          .add_if_async(key_data,
+                        key_data + rows,
+                        thrust::counting_iterator<cudf::size_type>{0},
+                        op::detail::probe_validity_of(keys),
+                        sref);
+      } else if (variant == "w64") {
+        add_w64_kernel<Key, 0, 256><<<grid, 256, 0, s.value()>>>(key_data, rows, mask, words, blocks);
+      } else if (variant == "w64_1024") {
+        add_w64_kernel<Key, 0, 1024>
+          <<<static_cast<unsigned>((rows + 1023) / 1024), 1024, 0, s.value()>>>(
+            key_data, rows, mask, words, blocks);
+      } else if (variant == "w64c") {
+        add_w64_kernel<Key, 1, 256><<<grid, 256, 0, s.value()>>>(key_data, rows, mask, words, blocks);
+      } else if (variant == "w64v") {
+        add_w64_kernel<Key, 2, 256><<<grid, 256, 0, s.value()>>>(key_data, rows, mask, words, blocks);
+      } else if (variant == "diag_rmw") {
+        diag_rmw_kernel<Key><<<grid, 256, 0, s.value()>>>(key_data, rows, words, blocks);
+      } else if (variant == "diag_read") {
+        diag_read_kernel<Key><<<grid, 256, 0, s.value()>>>(key_data, rows, words, blocks);
+      } else if (variant == "blk64") {
+        add_blk64_kernel<Key, 0><<<grid, 256, 0, s.value()>>>(key_data, rows, words, blocks * 4);
+      } else if (variant == "blk64c") {
+        add_blk64_kernel<Key, 1><<<grid, 256, 0, s.value()>>>(key_data, rows, words, blocks * 4);
+      } else if (variant == "sortpairs" || variant == "pairs") {
+        add_hashed_kernel<<<grid, 256, 0, s.value()>>>(pairs.data(), rows, words);
+      } else {
+        throw std::runtime_error("unknown variant " + variant);
+      }
+      check(cudaGetLastError(), "insert launch");
+    };
+    auto const scatter = [&] {
+      scattered = std::move(
+        cudf::hash_partition(table, {0}, parts, cudf::hash_id::HASH_MURMUR3, cudf::DEFAULT_HASH_SEED, task, mr)
+          .first);
+    };
+
+    auto const t0 = clk::now();
+    if (mode == "alone") {
+      insert(task);
+      task.synchronize();
+    } else if (mode == "hp_only") {
+      scatter();
+      task.synchronize();
+    } else if (mode == "hp_same") {
+      insert(task);
+      scatter();
+      task.synchronize();
+    } else if (mode == "hp_second") {
+      insert(second);
+      scatter();
+      task.synchronize();
+      second.synchronize();
+    } else {
+      throw std::runtime_error("unknown mode " + mode);
+    }
+    insert_ms.push_back(ms_since(t0));
+    scattered.reset();
+    rows_done += static_cast<std::uint64_t>(rows);
+  }
+  check(cudaDeviceSynchronize(), "sync end");
+
+  // Population count of the array, as a cheap cross-variant correctness signal.
+  std::uint64_t checksum = 0;
+  if (args.num("checksum", 0) != 0 && mode != "hp_only") {
+    std::vector<std::byte> host;
+    if (prod) {
+      auto contents = accumulated->inspect_partial(0, rmm::cuda_device_id{0});
+      host          = std::move(contents->bytes);
+    } else {
+      host.resize(array_bytes);
+      check(cudaMemcpy(host.data(), raw_bits.data(), array_bytes, cudaMemcpyDeviceToHost), "d2h");
+    }
+    std::uint64_t fnv = 1469598103934665603ULL;
+    for (std::size_t i = 0; i + 8 <= host.size(); i += 8) {
+      std::uint64_t w;
+      std::memcpy(&w, host.data() + i, 8);
+      fnv = (fnv ^ w) * 1099511628211ULL;
+    }
+    checksum = fnv;
+  }
+
+  // Drop the first batch (warm-up) when there are enough batches.
+  std::vector<double> steady = insert_ms;
+  if (steady.size() > 2) {
+    steady.erase(steady.begin());
+    batch_row_counts.erase(batch_row_counts.begin());
+  }
+  // Rate over the full-size steady batches only (a trailing partial batch is excluded).
+  auto const full_rows = *std::max_element(batch_row_counts.begin(), batch_row_counts.end());
+  std::vector<double> full;
+  for (std::size_t i = 0; i < steady.size(); ++i) {
+    if (batch_row_counts[i] == full_rows) { full.push_back(steady[i]); }
+  }
+  auto const st     = summarize(full);
+  auto const all    = summarize(insert_ms);
+  auto const prep   = summarize(prep_ms);
+  auto const rows_s = full_rows / (st.median / 1e3);
+  std::printf(
+    "RES,insert,label=%s,variant=%s,mode=%s,key=%zu,array_mib=%.0f,bpk=%zu,batch=%lld,batch_rows=%.0f,nulls=%d,dup=%llu,"
+    "order=%s,batches=%lld,rows=%llu,create_ms=%.2f,ms_batch_med=%.3f,ms_batch_min=%.3f,"
+    "ms_batch_max=%.3f,total_ms=%.1f,Mrows_s=%.1f,keyGB_s=%.2f,sectorGB_s=%.2f,prep_ms_med=%.3f,"
+    "checksum=%llx\n",
+    label.c_str(),
+    variant.c_str(),
+    mode.c_str(),
+    sizeof(Key) * 8,
+    static_cast<double>(array_bytes) / mib,
+    bpk,
+    static_cast<long long>(batch_rows),
+    full_rows,
+    nulls ? 1 : 0,
+    static_cast<unsigned long long>(dup),
+    spec.random ? "random" : "seq",
+    static_cast<long long>(batches),
+    static_cast<unsigned long long>(rows_done),
+    create_ms,
+    st.median,
+    st.min,
+    st.max,
+    all.sum,
+    rows_s / 1e6,
+    rows_s * sizeof(Key) / 1e9,
+    rows_s * 32 / 1e9,
+    prep.median,
+    static_cast<unsigned long long>(checksum));
+  std::fflush(stdout);
+  return 0;
+}
+
+// ---------------------------------------------------------------------------------------------
+// Probe + measured false-positive rate (MB6)
+// ---------------------------------------------------------------------------------------------
+
+struct probe_spec {
+  std::uint64_t members;   // inserted keys are mix64(0 .. members-1)
+  std::uint64_t base;      // per-repetition offset
+  std::uint32_t permille;  // hit rate
+  __host__ __device__ bool is_member(std::uint64_t i) const
+  {
+    return mix64((base + i) * 0x2545F4914F6CDD1DULL + 11) % 1000 < permille;
+  }
+  __host__ __device__ std::uint64_t operator()(std::uint64_t i) const
+  {
+    return is_member(i) ? mix64(mix64(base + i + 0x51ED) % members)
+                        : mix64(members + base + i);  // mix64 is a bijection: never inserted
+  }
+};
+
+int run_probe(arguments const& args)
+{
+  auto const array_bytes = static_cast<std::size_t>(args.num("array_mib", 300) * mib);
+  auto const bpk         = static_cast<std::size_t>(args.num("bpk", 16));
+  auto const build_batch = static_cast<std::int64_t>(args.num("batch", 64e6));
+  auto const probe_rows  = static_cast<std::int64_t>(args.num("probe", 64e6));
+  auto const reps        = static_cast<int>(args.num("reps", 6));
+  auto const sorted      = args.num("sorted_probe", 0) != 0;
+  auto const label       = args.str("label", "");
+  auto const blocks      = array_bytes / 32;
+  auto const members     = static_cast<std::uint64_t>(array_bytes) * 8 / bpk;
+
+  environment env{static_cast<std::size_t>(args.num("gpu_gib", 80)) << 30};
+  rmm::cuda_set_device_raii guard{rmm::cuda_device_id{0}};
+  rmm::cuda_stream_view const task{env.task.value()};
+  auto const mr = env.gpu().get_default_allocator();
+
+  auto accumulated = builder::try_create({{0, cudf::data_type{cudf::type_id::INT64}, blocks}}, env.spaces);
+  if (!accumulated) { throw std::runtime_error("lease refused"); }
+  {
+    key_batch batch{rmm::device_buffer{static_cast<std::size_t>(build_batch) * 8, task, env.raw},
+                    rmm::device_buffer{},
+                    cudf::type_id::INT64,
+                    0,
+                    0,
+                    false};
+    for (std::uint64_t done = 0; done < members;) {
+      auto const rows =
+        static_cast<cudf::size_type>(std::min<std::uint64_t>(static_cast<std::uint64_t>(build_batch), members - done));
+      fill_batch<std::int64_t>(batch, done, rows, key_spec{}, task);
+      if (!accumulated->enqueue_add(cudf::table_view{{batch.view()}}, rmm::cuda_device_id{0}, env.task_ref())) {
+        throw std::runtime_error("no partial");
+      }
+      task.synchronize();
+      done += static_cast<std::uint64_t>(rows);
+    }
+  }
+  auto const published = accumulated->finish(
+    rmm::cuda_device_id{0}, ::cuda::stream_ref{env.publication.value()}, mr);
+  if (!published || published->filters.size() != 1) { throw std::runtime_error("finish failed"); }
+  auto const& filter = *published->filters.front();
+  check(cudaDeviceSynchronize(), "sync finish");
+
+  rmm::device_buffer probe_data{static_cast<std::size_t>(probe_rows) * 8, task, env.raw};
+  auto* const probe_keys = static_cast<std::int64_t*>(probe_data.data());
+  for (std::uint32_t permille : {10U, 100U, 500U}) {
+    std::vector<double> ms;
+    std::uint64_t passed = 0, hits = 0, rows_total = 0;
+    for (int rep = 0; rep < reps + 1; ++rep) {
+      probe_spec const spec{members, static_cast<std::uint64_t>(rep) * static_cast<std::uint64_t>(probe_rows) +
+                                       std::uint64_t{permille} * 0x100000000ULL,
+                            permille};
+      thrust::for_each_n(rmm::exec_policy_nosync(task),
+                         thrust::counting_iterator<std::int64_t>{0},
+                         probe_rows,
+                         [=] __device__(std::int64_t i) {
+                           probe_keys[i] = static_cast<std::int64_t>(spec(static_cast<std::uint64_t>(i)));
+                         });
+      auto const member_rows = static_cast<std::uint64_t>(thrust::count_if(
+        rmm::exec_policy(task),
+        thrust::counting_iterator<std::int64_t>{0},
+        thrust::counting_iterator<std::int64_t>{probe_rows},
+        [=] __device__(std::int64_t i) { return spec.is_member(static_cast<std::uint64_t>(i)); }));
+      if (sorted) { thrust::sort(rmm::exec_policy(task), probe_keys, probe_keys + probe_rows); }
+      task.synchronize();
+      cudf::column_view const probe{
+        cudf::data_type{cudf::type_id::INT64}, static_cast<cudf::size_type>(probe_rows), probe_keys, nullptr, 0};
+      auto const t0   = clk::now();
+      auto const mask = filter.compute_mask(probe, nullptr, 0, env.task_ref(), mr);
+      task.synchronize();
+      auto const elapsed = ms_since(t0);
+      if (!mask) { throw std::runtime_error("probe declined"); }
+      auto const kept = static_cast<std::uint64_t>(thrust::count(
+        rmm::exec_policy(task), mask->view().data<bool>(), mask->view().data<bool>() + probe_rows, true));
+      if (rep == 0) { continue; }  // warm-up
+      ms.push_back(elapsed);
+      passed += kept;
+      hits += member_rows;
+      rows_total += static_cast<std::uint64_t>(probe_rows);
+    }
+    auto const st     = summarize(ms);
+    auto const rows_s = static_cast<double>(probe_rows) / (st.median / 1e3);
+    if (passed < hits) { throw std::runtime_error("false negatives"); }
+    std::printf(
+      "RES,probe,label=%s,array_mib=%.0f,bpk=%zu,members=%llu,probe=%lld,sorted=%d,hit_permille=%u,reps=%d,"
+      "ms_med=%.3f,ms_min=%.3f,ms_max=%.3f,Mrows_s=%.1f,keyGB_s=%.2f,nonmembers=%llu,false_pos=%llu,"
+      "fpr=%.6f\n",
+      label.c_str(),
+      static_cast<double>(array_bytes) / mib,
+      bpk,
+      static_cast<unsigned long long>(members),
+      static_cast<long long>(probe_rows),
+      sorted ? 1 : 0,
+      permille,
+      reps,
+      st.median,
+      st.min,
+      st.max,
+      rows_s / 1e6,
+      rows_s * 8 / 1e9,
+      static_cast<unsigned long long>(rows_total - hits),
+      static_cast<unsigned long long>(passed - hits),
+      static_cast<double>(passed - hits) / static_cast<double>(rows_total - hits));
+    std::fflush(stdout);
+  }
+  return 0;
+}
+
+// ---------------------------------------------------------------------------------------------
+// OP4: exact hash IN-list probe vs Bloom probe, production probe kernel (`run_membership_probe`
+// = cub::DeviceFor::Bulk over `membership_probe_functor`), production and prototype stores.
+// ---------------------------------------------------------------------------------------------
+
+// Dense-key model of TPC-H keys: universe [1, U]; index -> key is a bijection on the universe.
+struct dense_keys {
+  std::uint64_t universe;
+  std::uint64_t members;  // indices [0, members) are inserted
+  __host__ __device__ std::uint64_t key_of(std::uint64_t index) const
+  {
+    return (index * 1000003ULL) % universe + 1;
+  }
+};
+
+struct set_probe_spec {
+  dense_keys keys;
+  std::uint64_t base;
+  std::uint32_t hit_permille;
+  std::uint32_t prior_permille;  // rows the prior mask keeps
+  std::uint32_t run;             // consecutive probe rows sharing one key
+  bool ascending;                // clustered ascending keys (sorted fact-table column)
+  __host__ __device__ bool is_member(std::uint64_t row) const
+  {
+    auto const g = row / run;
+    return mix64((base + g) * 0x2545F4914F6CDD1DULL + 11) % 1000 < hit_permille;
+  }
+  __host__ __device__ bool prior(std::uint64_t row) const
+  {
+    return mix64((base + row) * 0x9E3779B97F4A7C15ULL + 5) % 1000 < prior_permille;
+  }
+  __host__ __device__ std::uint64_t operator()(std::uint64_t row) const
+  {
+    auto const g = row / run;
+    if (ascending) {
+      // Ascending raw key; membership is whatever the store says (counted by the exact reference).
+      return (base + g) % keys.universe + 1;
+    }
+    auto const r = mix64(base + g + 0x51ED);
+    return is_member(row) ? keys.key_of(r % keys.members)
+                          : keys.key_of(keys.members + r % (keys.universe - keys.members));
+  }
+};
+
+template <class Key, class Size, class Probing, int Bucket>
+using alt_set = cuco::static_set<Key,
+                                 cuco::extent<Size>,
+                                 ::cuda::thread_scope_device,
+                                 ::cuda::std::equal_to<Key>,
+                                 Probing,
+                                 op::detail::set_alloc<Key>,
+                                 cuco::storage<Bucket>>;
+template <class Key>
+using dh_scheme = cuco::double_hashing<1, cuco::default_hash_function<Key>>;
+template <class Key>
+using lp_scheme = cuco::linear_probing<1, cuco::default_hash_function<Key>>;
+
+template <class Set>
+std::unique_ptr<Set> make_alt_set(std::size_t capacity, rmm::device_async_resource_ref mr, ::cuda::stream_ref stream)
+{
+  using key_type  = typename Set::key_type;
+  using size_type = typename Set::size_type;
+  return std::unique_ptr<Set>(new Set{cuco::extent<size_type>{static_cast<size_type>(capacity)},
+                                      cuco::empty_key<key_type>{op::detail::set_sentinel<key_type>::value},
+                                      {},
+                                      {},
+                                      {},
+                                      {},
+                                      op::detail::set_alloc<key_type>{mr},
+                                      stream});
+}
+
+// Power-of-two open addressing, linear probing, one multiply hash: the cheapest exact lookup.
+template <class Key>
+struct pow2_lookup {
+  using key_type = Key;
+  Key const* slots;
+  std::uint32_t mask;
+  __device__ __forceinline__ static std::uint32_t hash(Key key) noexcept
+  {
+    auto x = static_cast<std::uint64_t>(key) * 0x9E3779B97F4A7C15ULL;
+    return static_cast<std::uint32_t>(x >> 32);
+  }
+  __device__ __forceinline__ bool operator()(Key key) const noexcept
+  {
+    constexpr Key empty = op::detail::set_sentinel<Key>::value;
+    if (key == empty) { return true; }
+    for (std::uint32_t i = hash(key) & mask;; i = (i + 1) & mask) {
+      Key const k = slots[i];
+      if (k == key) { return true; }
+      if (k == empty) { return false; }
+    }
+  }
+};
+
+template <class Key>
+struct pow2_inserter {
+  Key* slots;
+  std::uint32_t mask;
+  Key const* keys;
+  __device__ void operator()(std::int64_t r) const noexcept
+  {
+    constexpr Key empty = op::detail::set_sentinel<Key>::value;
+    Key const key       = keys[r];
+    for (std::uint32_t i = pow2_lookup<Key>::hash(key) & mask;; i = (i + 1) & mask) {
+      if constexpr (sizeof(Key) == 4) {
+        auto const old = atomicCAS(reinterpret_cast<unsigned int*>(slots + i),
+                                   static_cast<unsigned int>(empty),
+                                   static_cast<unsigned int>(key));
+        if (old == static_cast<unsigned int>(empty) || old == static_cast<unsigned int>(key)) { return; }
+      } else {
+        auto const old = atomicCAS(reinterpret_cast<unsigned long long*>(slots + i),
+                                   static_cast<unsigned long long>(empty),
+                                   static_cast<unsigned long long>(key));
+        if (old == static_cast<unsigned long long>(empty) || old == static_cast<unsigned long long>(key)) {
+          return;
+        }
+      }
+    }
+  }
+};
+
+template <class Key>
+void pow2_insert(Key* slots, std::uint32_t mask, Key const* keys, std::int64_t n, rmm::cuda_stream_view s)
+{
+  thrust::for_each_n(rmm::exec_policy_nosync(s),
+                     thrust::counting_iterator<std::int64_t>{0},
+                     n,
+                     pow2_inserter<Key>{slots, mask, keys});
+}
+
+// Bloom prefilter in front of an exact lookup.
+template <class First, class Second>
+struct and_lookup {
+  using key_type = typename Second::key_type;
+  First first;
+  Second second;
+  __device__ __forceinline__ bool operator()(key_type key) const noexcept { return first(key) && second(key); }
+};
+
+template <class Key, class Probe>
+int run_setprobe(arguments const& args)
+{
+  auto const members    = static_cast<std::uint64_t>(args.num("members", 400e3));
+  auto const universe   = static_cast<std::uint64_t>(args.num("universe", 200e6));
+  auto const probe_rows = static_cast<std::int64_t>(args.num("probe", 48e6));
+  auto const reps       = static_cast<int>(args.num("reps", 8));
+  auto const factor     = static_cast<std::size_t>(args.num("factor", 4));
+  auto const bpk        = args.num("bpk", 16);
+  auto const hit        = static_cast<std::uint32_t>(args.num("hit_permille", 2));
+  auto const prior      = static_cast<std::uint32_t>(args.num("prior_permille", 1000));
+  auto const run        = static_cast<std::uint32_t>(args.num("run", 1));
+  auto const ascending  = args.num("ascending", 0) != 0;
+  auto const variants   = args.str("variants", "prod,dh64,dh32,lp64,lp32,pow2,bloomprod,bloom,bloomset");
+  auto const label      = args.str("label", "");
+  dense_keys const keys{universe, members};
+
+  environment env{static_cast<std::size_t>(args.num("gpu_gib", 40)) << 30};
+  rmm::cuda_set_device_raii guard{rmm::cuda_device_id{0}};
+  rmm::cuda_stream_view const task{env.task.value()};
+  auto const mr = env.gpu().get_default_allocator();
+  auto const key_type_id  = sizeof(Key) == 4 ? cudf::type_id::INT32 : cudf::type_id::INT64;
+  auto const probe_type_id = sizeof(Probe) == 4 ? cudf::type_id::INT32 : cudf::type_id::INT64;
+  auto const domain = *op::classify_membership_key(cudf::data_type{key_type_id});
+
+  // Build keys.
+  rmm::device_buffer build_data{members * sizeof(Key), task, env.raw};
+  auto* const build_keys = static_cast<Key*>(build_data.data());
+  thrust::for_each_n(rmm::exec_policy_nosync(task),
+                     thrust::counting_iterator<std::int64_t>{0},
+                     static_cast<std::int64_t>(members),
+                     [=] __device__(std::int64_t i) {
+                       build_keys[i] = static_cast<Key>(keys.key_of(static_cast<std::uint64_t>(i)));
+                     });
+  task.synchronize();
+  cudf::column_view const build{
+    cudf::data_type{key_type_id}, static_cast<cudf::size_type>(members), build_keys, nullptr, 0};
+
+  // Stores.
+  op::sirius_dynamic_in_list_filter prod_set{build, env.task_ref(), mr};
+  op::sirius_dynamic_bloom_filter prod_bloom{build, env.task_ref(), mr};
+  auto const capacity = std::max<std::size_t>(factor * members, 8);
+  auto dh64 = make_alt_set<alt_set<Key, std::size_t, dh_scheme<Key>, 4>>(capacity, mr, env.task_ref());
+  auto dh32 = make_alt_set<alt_set<Key, std::uint32_t, dh_scheme<Key>, 4>>(capacity, mr, env.task_ref());
+  auto lp64 = make_alt_set<alt_set<Key, std::size_t, lp_scheme<Key>, 4>>(capacity, mr, env.task_ref());
+  auto lp32 = make_alt_set<alt_set<Key, std::uint32_t, lp_scheme<Key>, 4>>(capacity, mr, env.task_ref());
+  dh64->insert_async(build_keys, build_keys + members, env.task_ref());
+  dh32->insert_async(build_keys, build_keys + members, env.task_ref());
+  lp64->insert_async(build_keys, build_keys + members, env.task_ref());
+  lp32->insert_async(build_keys, build_keys + members, env.task_ref());
+  std::uint32_t pow2_slots = 8;
+  while (pow2_slots < factor * members) { pow2_slots <<= 1; }
+  rmm::device_buffer pow2_data{std::size_t{pow2_slots} * sizeof(Key), task, env.raw};
+  auto* const pow2 = static_cast<Key*>(pow2_data.data());
+  thrust::fill_n(rmm::exec_policy_nosync(task), pow2, pow2_slots, op::detail::set_sentinel<Key>::value);
+  pow2_insert(pow2, pow2_slots - 1, build_keys, static_cast<std::int64_t>(members), task);
+  auto const bloom_blocks =
+    std::max<std::size_t>(1, static_cast<std::size_t>(static_cast<double>(members) * bpk / 256.0 + 0.999));
+  std::unique_ptr<op::detail::sirius_bloom<Key>> bloom{new op::detail::sirius_bloom<Key>{
+    cuco::extent<std::size_t>{bloom_blocks}, {}, {}, op::detail::bloom_alloc{mr}, env.task_ref()}};
+  bloom->add_async(build_keys, build_keys + members, env.task_ref());
+  task.synchronize();
+
+  rmm::device_buffer probe_data{static_cast<std::size_t>(probe_rows) * sizeof(Probe), task, env.raw};
+  auto* const probe_keys = static_cast<Probe*>(probe_data.data());
+  auto const words       = (probe_rows + 31) / 32;
+  rmm::device_buffer prior_data{static_cast<std::size_t>(words) * 4, task, env.raw};
+  auto* const prior_words = static_cast<std::uint32_t*>(prior_data.data());
+  rmm::device_buffer ref_data{static_cast<std::size_t>(probe_rows), task, env.raw};
+  auto* const reference = static_cast<bool*>(ref_data.data());
+
+  struct variant_result {
+    std::vector<double> ms;
+    std::uint64_t kept = 0, expected = 0, rows = 0, live = 0;
+  };
+  std::map<std::string, variant_result> results;
+  std::vector<std::string> order;
+  for (std::size_t pos = 0; pos <= variants.size();) {
+    auto const next = variants.find(',', pos);
+    order.push_back(variants.substr(pos, next == std::string::npos ? std::string::npos : next - pos));
+    if (next == std::string::npos) { break; }
+    pos = next + 1;
+  }
+
+  for (int rep = 0; rep < reps + 1; ++rep) {
+    set_probe_spec const spec{keys, static_cast<std::uint64_t>(rep) * static_cast<std::uint64_t>(probe_rows) + 977,
+                              hit, prior, run, ascending};
+    thrust::for_each_n(rmm::exec_policy_nosync(task),
+                       thrust::counting_iterator<std::int64_t>{0},
+                       probe_rows,
+                       [=] __device__(std::int64_t i) {
+                         probe_keys[i] = static_cast<Probe>(spec(static_cast<std::uint64_t>(i)));
+                       });
+    thrust::for_each_n(rmm::exec_policy_nosync(task),
+                       thrust::counting_iterator<std::int64_t>{0},
+                       words,
+                       [=] __device__(std::int64_t w) {
+                         std::uint32_t bits = 0;
+                         for (int b = 0; b < 32; ++b) {
+                           bits |= static_cast<std::uint32_t>(spec.prior(static_cast<std::uint64_t>(w) * 32 + b)) << b;
+                         }
+                         prior_words[w] = bits;
+                       });
+    task.synchronize();
+    cudf::column_view const probe{
+      cudf::data_type{probe_type_id}, static_cast<cudf::size_type>(probe_rows), probe_keys, nullptr, 0};
+    auto const* const prior_arg = prior >= 1000 ? nullptr : prior_words;
+    // Exact reference (the pow2 table, checked against the generator when not ascending).
+    std::uint64_t expected = 0;
+    {
+      auto const mask = op::detail::run_membership_probe<Key>(
+        domain, probe, prior_arg, env.task_ref(), mr, pow2_lookup<Key>{pow2, pow2_slots - 1});
+      task.synchronize();
+      check(cudaMemcpyAsync(reference, mask->view().template data<bool>(), static_cast<std::size_t>(probe_rows),
+                            cudaMemcpyDeviceToDevice, task.value()), "ref copy");
+      expected = static_cast<std::uint64_t>(
+        thrust::count(rmm::exec_policy(task), reference, reference + probe_rows, true));
+      if (!ascending) {
+        auto const generated = static_cast<std::uint64_t>(thrust::count_if(
+          rmm::exec_policy(task),
+          thrust::counting_iterator<std::int64_t>{0},
+          thrust::counting_iterator<std::int64_t>{probe_rows},
+          [=] __device__(std::int64_t i) {
+            return spec.is_member(static_cast<std::uint64_t>(i)) &&
+                   (prior >= 1000 || spec.prior(static_cast<std::uint64_t>(i)));
+          }));
+        if (generated != expected) { throw std::runtime_error("reference disagrees with generator"); }
+      }
+    }
+    auto const live = prior >= 1000 ? static_cast<std::uint64_t>(probe_rows)
+                                    : static_cast<std::uint64_t>(thrust::count_if(
+                                        rmm::exec_policy(task),
+                                        thrust::counting_iterator<std::int64_t>{0},
+                                        thrust::counting_iterator<std::int64_t>{probe_rows},
+                                        [=] __device__(std::int64_t i) {
+                                          return spec.prior(static_cast<std::uint64_t>(i));
+                                        }));
+    for (auto const& name : order) {
+      std::unique_ptr<cudf::column> mask;
+      task.synchronize();
+      auto const t0 = clk::now();
+      auto const go = [&](auto lookup) {
+        mask = op::detail::run_membership_probe<Key>(domain, probe, prior_arg, env.task_ref(), mr, lookup);
+      };
+      using op::detail::bloom_lookup;
+      using op::detail::set_lookup;
+      if (name == "prod") {
+        mask = prod_set.compute_mask(probe, prior_arg, 0, env.task_ref(), mr);
+      } else if (name == "bloomprod") {
+        mask = prod_bloom.compute_mask(probe, prior_arg, 0, env.task_ref(), mr);
+      } else if (name == "dh64") {
+        auto ref = dh64->ref(cuco::contains);
+        go(set_lookup<decltype(ref)>{ref});
+      } else if (name == "dh32") {
+        auto ref = dh32->ref(cuco::contains);
+        go(set_lookup<decltype(ref)>{ref});
+      } else if (name == "lp64") {
+        auto ref = lp64->ref(cuco::contains);
+        go(set_lookup<decltype(ref)>{ref});
+      } else if (name == "lp32") {
+        auto ref = lp32->ref(cuco::contains);
+        go(set_lookup<decltype(ref)>{ref});
+      } else if (name == "pow2") {
+        go(pow2_lookup<Key>{pow2, pow2_slots - 1});
+      } else if (name == "bloom") {
+        auto ref = bloom->ref();
+        go(bloom_lookup<decltype(ref)>{ref});
+      } else if (name == "bloomset") {
+        auto bref = bloom->ref();
+        auto sref = dh64->ref(cuco::contains);
+        go(and_lookup<bloom_lookup<decltype(bref)>, set_lookup<decltype(sref)>>{{bref}, {sref}});
+      } else if (name == "bloompow2") {
+        auto bref = bloom->ref();
+        go(and_lookup<bloom_lookup<decltype(bref)>, pow2_lookup<Key>>{{bref}, {pow2, pow2_slots - 1}});
+      } else {
+        throw std::runtime_error("unknown variant " + name);
+      }
+      task.synchronize();
+      auto const elapsed = ms_since(t0);
+      if (!mask) { throw std::runtime_error("probe declined: " + name); }
+      auto const* const got = mask->view().template data<bool>();
+      auto const kept = static_cast<std::uint64_t>(thrust::count(rmm::exec_policy(task), got, got + probe_rows, true));
+      auto const* const refp = reference;
+      auto const lost = static_cast<std::uint64_t>(thrust::count_if(
+        rmm::exec_policy(task),
+        thrust::counting_iterator<std::int64_t>{0},
+        thrust::counting_iterator<std::int64_t>{probe_rows},
+        [=] __device__(std::int64_t i) { return refp[i] && !got[i]; }));
+      if (lost != 0) { throw std::runtime_error("false negatives: " + name); }
+      bool const exact = name.rfind("bloom", 0) != 0 || name == "bloomset" || name == "bloompow2";
+      if (exact && kept != expected) { throw std::runtime_error("exact variant kept a non-member: " + name); }
+      if (rep == 0) { continue; }
+      auto& r = results[name];
+      r.ms.push_back(elapsed);
+      r.kept += kept;
+      r.expected += expected;
+      r.rows += static_cast<std::uint64_t>(probe_rows);
+      r.live += live;
+    }
+  }
+  for (auto const& name : order) {
+    auto const& r = results[name];
+    auto const st = summarize(r.ms);
+    std::printf(
+      "RES,setprobe,label=%s,variant=%s,key=%zu,probe_key=%zu,members=%llu,universe=%llu,factor=%zu,bpk=%.0f,"
+      "set_bytes=%zu,pow2_bytes=%zu,bloom_bytes=%zu,probe=%lld,hit_permille=%u,prior_permille=%u,run=%u,asc=%d,"
+      "reps=%d,ms_med=%.3f,ms_min=%.3f,ms_max=%.3f,Grows_s=%.1f,kept=%llu,expected=%llu,fp=%llu,"
+      "fpr_live=%.6f\n",
+      label.c_str(), name.c_str(), sizeof(Key) * 8, sizeof(Probe) * 8,
+      static_cast<unsigned long long>(members), static_cast<unsigned long long>(universe), factor, bpk,
+      prod_set.storage_bytes(), std::size_t{pow2_slots} * sizeof(Key), bloom_blocks * 32,
+      static_cast<long long>(probe_rows), hit, prior, run, ascending ? 1 : 0, reps, st.median, st.min, st.max,
+      static_cast<double>(probe_rows) / st.median / 1e6,
+      static_cast<unsigned long long>(r.kept), static_cast<unsigned long long>(r.expected),
+      static_cast<unsigned long long>(r.kept - r.expected),
+      r.live > r.expected ? static_cast<double>(r.kept - r.expected) / static_cast<double>(r.live - r.expected) : 0.0);
+  }
+  std::fflush(stdout);
+  return 0;
+}
+
+}  // namespace
+
+int main(int argc, char** argv)
+{
+  arguments args;
+  for (int i = 1; i < argc; ++i) {
+    std::string const a{argv[i]};
+    auto const eq = a.find('=');
+    if (eq == std::string::npos) {
+      std::fprintf(stderr, "bad argument %s\n", a.c_str());
+      return 2;
+    }
+    args.kv[a.substr(0, eq)] = a.substr(eq + 1);
+  }
+  try {
+    auto const suite = args.str("suite", "insert");
+    if (suite == "probe") { return run_probe(args); }
+    if (suite == "setprobe") {
+      bool const k32 = args.num("key", 32) == 32;
+      bool const p32 = args.num("probe_key", args.num("key", 32)) == 32;
+      if (k32) { return p32 ? run_setprobe<std::int32_t, std::int32_t>(args) : 2; }
+      return p32 ? run_setprobe<std::int64_t, std::int32_t>(args) : run_setprobe<std::int64_t, std::int64_t>(args);
+    }
+    if (suite == "insert") {
+      return args.num("key", 64) == 32 ? run_insert<std::int32_t>(args) : run_insert<std::int64_t>(args);
+    }
+    std::fprintf(stderr, "unknown suite\n");
+    return 2;
+  } catch (std::exception const& e) {
+    std::fprintf(stderr, "FAILED: %s\n", e.what());
+    return 1;
+  }
+}
