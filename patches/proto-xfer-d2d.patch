+/**
+ * @brief Flushes the CUDA trace when a case ends: nsys loses the API trace of this binary
+ * otherwise.
+ */
+struct trace_flush {
+  trace_flush()                              = default;
+  trace_flush(trace_flush const&)            = delete;
+  trace_flush& operator=(trace_flush const&) = delete;
+  ~trace_flush() { (void)cudaProfilerStop(); }
+};
