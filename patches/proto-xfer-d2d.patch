+          made.reset();
+          sync_devices(gpus);
+          auto const released = clock_type::now();
+          if (rep != 0) {
+            create.add(us_between(start, leased));
+            zero.add(us_between(leased, zeroed));
+            destroy.add(us_between(zeroed, released));
+          }
+        }
