+          gpus,
+          keys,
+          static_cast<unsigned long long>(megabytes),
+          create.median(),
+          create.minimum(),
+          zero.median(),
+          zero.minimum(),
+          destroy.median(),
+          destroy.minimum());
+        std::fflush(stdout);
+      }
+    }
+  }
+}
