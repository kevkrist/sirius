+    for (auto& peer : _peers) {
+      rmm::cuda_set_device_raii guard{rmm::cuda_device_id{peer.part->device_id}};
+      peer.ready.emplace();
+      peer.fin.emplace();
+      record(*peer.ready, peer.part->device_id, peer.part->stream->value());
+      wait(peer.part->device_id, peer.down, *peer.ready);
