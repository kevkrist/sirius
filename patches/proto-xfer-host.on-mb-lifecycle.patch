+    std::optional<cuda_event> fin;            // The partial's whole publication work
+    std::vector<cuda_event> up_done;          // Per output slot: this GPU's upload of it landed
+  };
+  struct chunk {
+    std::size_t key_index;
+    std::size_t offset;
+    std::size_t bytes;
