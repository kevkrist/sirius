+   */
+  host_pipeline(impl const& owner,
+                partial& root,
+                std::span<partial* const> sources,
+                ::cuda::stream_ref stream,
+                cucascade::memory::fixed_size_host_memory_resource& host,
+                schedule kind,
+                std::size_t window,
+                std::size_t chunk_count)
